  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  author      User        @relation("EventAuthor", fields: [authorId], references: [id])

  @@index([institutionId])
  @@index([eventDate])
  @@index([isActive])
}

// ============================================
// MÓDULO DE RECUPERACIONES ACADÉMICAS
// Decreto 1290 - SIEE Colombia
// ============================================

enum RecoveryType {
  PERIOD // Recuperación por período
  FINAL // Recuperación final (plan de apoyo)
}

// Tipo de actividad de recuperación (modalidad pedagógica)
enum RecoveryActivityType {
  REINFORCEMENT // Refuerzo: actividad complementaria simple
  LEVELING // Nivelación: curso corto de refuerzo
  EXAM // Habilitación: examen formal
  VALIDATION // Validación: prueba completa de competencias
  WORKSHOP // Taller: actividad práctica dirigida
  PROJECT // Proyecto: trabajo de investigación o aplicación
}

enum RecoveryStatus {
  PENDING // Pendiente de iniciar
  ASSIGNED // Asignado a docente pero no iniciado
  IN_PROGRESS // En proceso de ejecución
  COMPLETED // Completada por el estudiante
  REVIEW_PENDING // Pendiente de revisión por coordinador
  APPROVED // Aprobada
  NOT_APPROVED // No aprobada
  CANCELLED // Cancelada
}

enum RecoveryImpactType {
  ADJUST_TO_MINIMUM // Ajustar hasta la nota mínima aprobatoria
  AVERAGE_WITH_ORIGINAL // Promediar con nota original
  REPLACE_IF_HIGHER // Reemplazar solo si es mayor
  QUALITATIVE_ONLY // Solo registro cualitativo (no afecta nota)
}

// Estado de promoción del estudiante (calculado tras recuperaciones)
enum PromotionStatus {
  IN_PROGRESS // Año en curso
  PROMOTED // Promovido directamente
  PROMOTED_AFTER_RECOVERY // Promovido después de recuperación
  RETAINED // Repitente
  PENDING_RECOVERY // Pendiente de recuperación final
  TRANSFERRED // Trasladado
  WITHDRAWN // Retirado
}

// AcademicActType movido a la sección de enums de Año Lectivo (línea ~102)

// Configuración institucional de recuperaciones
model RecoveryConfig {
  id             String @id @default(cuid())
  institutionId  String
  academicYearId String

  // Configuración general
  minPassingScore Decimal @default(3.0) @db.Decimal(5, 2)

  // Recuperación por período
  periodRecoveryEnabled        Boolean            @default(true)
  periodMaxScore               Decimal            @default(3.0) @db.Decimal(5, 2)
  periodImpactType             RecoveryImpactType @default(ADJUST_TO_MINIMUM)
  periodRecoveryMaxAttempts    Int                @default(1)
  periodRequiresReviewApproval Boolean            @default(true)

  // Recuperación final
  finalRecoveryEnabled     Boolean            @default(true)
  finalMaxScore            Decimal            @default(3.0) @db.Decimal(5, 2)
  finalImpactType          RecoveryImpactType @default(ADJUST_TO_MINIMUM)
  finalRecoveryMaxAttempts Int                @default(1)
  maxAreasRecoverable      Int                @default(2)
  maxSubjectsRecoverable   Int? // Máx. asignaturas recuperables (null = sin límite)

  // Umbrales de reprobación automática
  autoRetainAreas    Int? // Si pierde >= N áreas → repite automáticamente
  autoRetainSubjects Int? // Si pierde >= N asignaturas → repite automáticamente

  // Fechas de ventanas de recuperación
  periodRecoveryStartDate DateTime?
  periodRecoveryEndDate   DateTime?
  finalRecoveryStartDate  DateTime?
  finalRecoveryEndDate    DateTime?

  // Actas requeridas
  requiresAcademicCouncilAct Boolean @default(true)
  requiresPromotionAct       Boolean @default(true)

  // Reglas granulares por tipo de actividad (relación)
  recoveryRules RecoveryRule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([institutionId, academicYearId])
}

// Regla de recuperación granular (por tipo de actividad y alcance)
model RecoveryRule {
  id               String @id @default(cuid())
  recoveryConfigId String
  institutionId    String

  // Alcance: PERIOD o FINAL
  appliesTo    RecoveryType
  // Tipo de actividad pedagógica
  activityType RecoveryActivityType

  // Configuración de la regla
  maxScore    Decimal            @db.Decimal(5, 2)
  impactType  RecoveryImpactType @default(ADJUST_TO_MINIMUM)
  maxAttempts Int                @default(1)
  isEnabled   Boolean            @default(true)

  // Descripción para UI
  label       String? // Ej: "Habilitación de período"
  description String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recoveryConfig RecoveryConfig @relation(fields: [recoveryConfigId], references: [id], onDelete: Cascade)
  institution    Institution    @relation(fields: [institutionId], references: [id])

  @@unique([recoveryConfigId, appliesTo, activityType])
  @@index([institutionId])
}

// Recuperación por período
model PeriodRecovery {
  id                  String @id @default(cuid())
  institutionId       String
  studentEnrollmentId String
  academicTermId      String
  subjectId           String

  // Nota original que generó la recuperación
  originalScore Decimal @db.Decimal(5, 2)

  // Información de la recuperación
  status              RecoveryStatus        @default(PENDING)
  activityType        RecoveryActivityType? // Tipo de actividad de recuperación
  activityDescription String?               @db.Text
  scheduledDate       DateTime?
  completedDate       DateTime?
  attemptNumber       Int                   @default(1)

  // Dimensión reforzada
  reinforcedDimension String? @default("COGNITIVA")

  // Resultado
  recoveryScore Decimal?            @db.Decimal(5, 2)
  finalScore    Decimal?            @db.Decimal(5, 2)
  impactType    RecoveryImpactType?

  // Evidencias y observaciones
  evidences    String? @db.Text
  observations String? @db.Text

  // Responsables
  assignedById  String
  evaluatedById String?
  reviewedById  String? // Coordinador que revisó

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution       Institution       @relation("RlsInstitutionPR", fields: [institutionId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicTerm      AcademicTerm      @relation("PeriodRecoveryTerm", fields: [academicTermId], references: [id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  assignedBy        User              @relation("RecoveryAssignedBy", fields: [assignedById], references: [id])
  evaluatedBy       User?             @relation("RecoveryEvaluatedBy", fields: [evaluatedById], references: [id])
  reviewedBy        User?             @relation("RecoveryReviewedBy", fields: [reviewedById], references: [id])

  @@index([studentEnrollmentId])
  @@index([academicTermId])
  @@index([status])
}

// Plan de apoyo final (recuperación final por área)
model FinalRecoveryPlan {
  id                  String @id @default(cuid())
  institutionId       String
  studentEnrollmentId String
  academicYearId      String
  areaId              String

  // Nota final del área que generó el plan
  originalAreaScore Decimal @db.Decimal(5, 2)

  // Estado del plan
  status       RecoveryStatus        @default(PENDING)
  activityType RecoveryActivityType? // Tipo de actividad de recuperación final

  // Plan de actividades
  activities String? @db.Text
  objectives String? @db.Text
  resources  String? @db.Text

  // Fechas
  startDate     DateTime?
  endDate       DateTime?
  completedDate DateTime?
  attemptNumber Int       @default(1)

  // Resultado
  recoveryScore  Decimal?            @db.Decimal(5, 2)
  finalAreaScore Decimal?            @db.Decimal(5, 2)
  impactType     RecoveryImpactType?

  // Evidencias y observaciones
  evidences    String? @db.Text
  observations String? @db.Text

  // Responsables
  responsibleTeacherId String
  supervisorId         String?

  // Decisión final
  finalDecision String?
  approvedById  String?
  approvalDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution        Institution       @relation("RlsInstitutionFRP", fields: [institutionId], references: [id])
  studentEnrollment  StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear      @relation("FinalRecoveryYear", fields: [academicYearId], references: [id], onDelete: Cascade)
  area               Area              @relation(fields: [areaId], references: [id], onDelete: Cascade)
  responsibleTeacher User              @relation("FinalRecoveryTeacher", fields: [responsibleTeacherId], references: [id])
  supervisor         User?             @relation("FinalRecoverySupervisor", fields: [supervisorId], references: [id])
  approvedBy         User?             @relation("FinalRecoveryApprover", fields: [approvedById], references: [id])
  academicActs       AcademicAct[]

  @@index([studentEnrollmentId])
  @@index([academicYearId])
  @@index([status])
}

// Actas académicas
model AcademicAct {
  id             String @id @default(cuid())
  institutionId  String
  academicYearId String

  // Tipo y número de acta
  actType   AcademicActType
  actNumber String
  actDate   DateTime

  // Contenido
  title     String
  content   String  @db.Text
  decisions String? @db.Text
  attendees String? @db.Text

  // Participantes y adjuntos estructurados
  participants Json? // [{name, role, document, signature?}]
  attachments  Json? // [{name, url, type}]
  notes        String? @db.Text

  // Relaciones opcionales
  studentEnrollmentId String?
  finalRecoveryPlanId String?

  // Firmas y aprobación
  createdById  String
  approvedById String?
  approvalDate DateTime?

  // Documento generado
  documentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment? @relation(fields: [studentEnrollmentId], references: [id])
  finalRecoveryPlan FinalRecoveryPlan? @relation(fields: [finalRecoveryPlanId], references: [id])
  createdBy         User               @relation("ActCreatedBy", fields: [createdById], references: [id])
  approvedBy        User?              @relation("ActApprovedBy", fields: [approvedById], references: [id])

  // Eventos de matrícula relacionados con esta acta
  enrollmentEvents EnrollmentEvent[]

  @@index([institutionId])
  @@index([academicYearId])
  @@index([actType])
}

// ==================== SISTEMA DE DESEMPEÑOS ====================

// Dimensiones de evaluación (Cognitivo, Procedimental, Actitudinal)
enum PerformanceDimension {
  COGNITIVO
  PROCEDIMENTAL
  ACTITUDINAL
}

// Configuración de complementos por nivel de desempeño
model PerformanceLevelComplement {
  id            String                @id @default(cuid())
  institutionId String
  level         PerformanceLevel
  complement    String                @db.Text
  isActive      Boolean               @default(true)
  displayMode   ComplementDisplayMode @default(CONCATENATE)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, level])
}

enum ComplementDisplayMode {
  CONCATENATE // Se concatena al texto base
  SEPARATE_LINE // Se muestra en línea separada
}

// Configuración del módulo de desempeños por institución
model PerformanceConfig {
  id              String   @id @default(cuid())
  institutionId   String   @unique
  isEnabled       Boolean  @default(true)
  showByDimension Boolean  @default(true) // true = por dimensión, false = consolidado
  allowManualEdit Boolean  @default(false) // Permitir edición manual excepcional
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

// Desempeño base registrado por el docente (por asignatura, período y dimensión)
model SubjectPerformance {
  id                  String               @id @default(cuid())
  institutionId       String
  teacherAssignmentId String
  academicTermId      String
  dimension           PerformanceDimension
  baseDescription     String               @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  institution       Institution       @relation("RlsInstitutionSP", fields: [institutionId], references: [id])
  teacherAssignment TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  academicTerm      AcademicTerm      @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  @@unique([teacherAssignmentId, academicTermId, dimension])
  @@index([teacherAssignmentId])
  @@index([academicTermId])
}

// Registro de ediciones manuales (auditoría)
model PerformanceManualEdit {
  id                  String               @id @default(cuid())
  institutionId       String
  studentEnrollmentId String
  academicTermId      String
  subjectId           String
  dimension           PerformanceDimension
  originalText        String               @db.Text
  editedText          String               @db.Text
  reason              String
  editedById          String
  createdAt           DateTime             @default(now())

  institution       Institution       @relation("RlsInstitutionPME", fields: [institutionId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicTerm      AcademicTerm      @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  editedBy          User              @relation("PerformanceEditedBy", fields: [editedById], references: [id])

  @@index([studentEnrollmentId])
  @@index([academicTermId])
}

// ═══════════════════════════════════════════════════════════════════════════
// SISTEMA DE LOGROS Y JUICIOS VALORATIVOS
// ═══════════════════════════════════════════════════════════════════════════

// Configuración institucional del módulo de logros
model AchievementConfig {
  id            String @id @default(cuid())
  institutionId String @unique

  // Configuración de logros por período
  achievementsPerPeriod     Int     @default(1) // Número de logros académicos por período
  usePromotionalAchievement Boolean @default(true) // Usar logro promocional (fin de año)

  // Configuración de logro actitudinal
  useAttitudinalAchievement Boolean                    @default(false) // Habilitar logro actitudinal
  attitudinalMode           AttitudinalAchievementMode @default(GENERAL_PER_PERIOD) // Modo del logro actitudinal

  // Configuración de juicios valorativos
  useValueJudgments Boolean @default(true) // Habilitar juicios valorativos por desempeño

  // Configuración de observaciones
  useObservations Boolean @default(false) // Habilitar campo de observación por estudiante (el docente escribe manualmente)

  // Configuración de visualización en boletín
  displayMode      AchievementDisplayMode   @default(SEPARATE) // Cómo mostrar logros en boletín
  displayFormat    AchievementDisplayFormat @default(LIST) // Formato de visualización
  judgmentPosition JudgmentPosition         @default(END_OF_EACH) // Posición del juicio valorativo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution            Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  valueJudgmentTemplates ValueJudgmentTemplate[]
  observationTemplates   ObservationTemplate[]
}

enum AchievementDisplayMode {
  SEPARATE // Académico y Actitudinal separados
  COMBINED // Todo en un solo texto combinado
}

enum AchievementDisplayFormat {
  LIST // Lista numerada
  PARAGRAPH // Párrafo continuo
}

enum JudgmentPosition {
  END_OF_EACH // Al final de cada logro
  END_OF_ALL // Al final de todos los logros
  NONE // No mostrar
}

enum AttitudinalAchievementMode {
  GENERAL_PER_PERIOD // Un logro actitudinal general por período
  PER_ACADEMIC_ACHIEVEMENT // Un logro actitudinal por cada logro académico
}

// Plantillas de observación por nivel de desempeño (para autocompletar observación en logros)
model ObservationTemplate {
  id                  String           @id @default(cuid())
  achievementConfigId String
  level               PerformanceLevel
  template            String           @db.Text // Texto plantilla para este nivel
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  achievementConfig AchievementConfig @relation(fields: [achievementConfigId], references: [id], onDelete: Cascade)

  @@unique([achievementConfigId, level])
}

// Plantillas de juicios valorativos por nivel de desempeño
model ValueJudgmentTemplate {
  id                  String           @id @default(cuid())
  achievementConfigId String
  level               PerformanceLevel
  template            String           @db.Text // Texto sugerido para este nivel
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  achievementConfig AchievementConfig @relation(fields: [achievementConfigId], references: [id], onDelete: Cascade)

  @@unique([achievementConfigId, level])
}

// Logro académico definido por el docente (por asignatura, período)
model Achievement {
  id                  String          @id @default(cuid())
  institutionId       String
  code                String // Código interno (ej: LOG-MAT-P1-01)
  teacherAssignmentId String
  academicTermId      String
  orderNumber         Int             @default(1) // Número de logro (1, 2, 3...)
  achievementType     AchievementType @default(ACADEMIC) // Tipo de logro
  baseDescription     String          @db.Text // Texto base del logro
  isPromotional       Boolean         @default(false) // Es logro promocional (fin de año)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  institution             Institution              @relation("RlsInstitutionACH", fields: [institutionId], references: [id])
  teacherAssignment       TeacherAssignment        @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  academicTerm            AcademicTerm             @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  studentAchievements     StudentAchievement[]
  attitudinalAchievements AttitudinalAchievement[]
  pedagogicalSupportPlans PedagogicalSupportPlan[]

  @@unique([teacherAssignmentId, academicTermId, orderNumber, isPromotional])
  @@unique([code, teacherAssignmentId]) // Código único por asignación
  @@index([teacherAssignmentId])
  @@index([academicTermId])
  @@index([code])
}

enum AchievementType {
  ACADEMIC // Logro académico
  ATTITUDINAL // Logro actitudinal
  PROMOTIONAL // Logro promocional
}

// Estado de plan de acompañamiento pedagógico (DIMENSIONS)
enum SupportStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// Logro actitudinal (puede ser general o asociado a un logro académico)
model AttitudinalAchievement {
  id                  String   @id @default(cuid())
  institutionId       String
  teacherAssignmentId String
  academicTermId      String
  achievementId       String? // NULL = general por período, NOT NULL = asociado a logro académico
  description         String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  institution       Institution       @relation("RlsInstitutionAACH", fields: [institutionId], references: [id])
  teacherAssignment TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  academicTerm      AcademicTerm      @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  achievement       Achievement?      @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@index([teacherAssignmentId])
  @@index([academicTermId])
}

// Logro del estudiante (con nota, texto adaptado y juicio valorativo)
model StudentAchievement {
  id                  String @id @default(cuid())
  institutionId       String
  studentEnrollmentId String
  achievementId       String

  // El desempeño se calcula automáticamente desde la nota
  performanceLevel PerformanceLevel // BAJO, BASICO, ALTO, SUPERIOR (calculado)

  // Textos sugeridos por el sistema, editables por el docente
  suggestedText  String? @db.Text // Texto sugerido según desempeño
  approvedText   String? @db.Text // Texto aprobado por el docente
  isTextApproved Boolean @default(false)

  // Juicio valorativo
  suggestedJudgment  String? @db.Text // Juicio sugerido según desempeño
  approvedJudgment   String? @db.Text // Juicio aprobado por el docente
  isJudgmentApproved Boolean @default(false)

  // Observación del docente (lo que va al boletín)
  observation String? @db.Text

  // Logro actitudinal combinado (si aplica)
  attitudinalText String? @db.Text

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  approvedAt   DateTime? // Fecha de aprobación final
  approvedById String? // Quién aprobó

  institution       Institution       @relation("RlsInstitutionSACH", fields: [institutionId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  achievement       Achievement       @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  approvedBy        User?             @relation("AchievementApprovedBy", fields: [approvedById], references: [id])

  @@unique([studentEnrollmentId, achievementId])
  @@index([studentEnrollmentId])
  @@index([achievementId])
}

// ═══════════════════════════════════════════════════════════════════════════
// BANCO DE LOGROS (Plantillas reutilizables de logros)
// Permite a docentes y coordinadores crear un repositorio de logros
// que pueden reutilizarse entre períodos y años académicos.
// ═══════════════════════════════════════════════════════════════════════════

model AchievementBank {
  id            String  @id @default(cuid())
  institutionId String
  subjectId     String? // NULL = logro general, NOT NULL = específico de asignatura
  areaId        String? // Área académica (para filtrar por área)
  gradeId       String? // Grado específico (NULL = aplica a todos)

  // Contenido
  description      String            @db.Text // Texto del logro
  achievementType  AchievementType   @default(ACADEMIC)
  performanceLevel PerformanceLevel? // Nivel sugerido (SUPERIOR, ALTO, BASICO, BAJO) o NULL = genérico

  // Clasificación
  category String? // Categoría libre (ej: "Pensamiento numérico", "Lectura crítica")
  tags     String? // Tags separados por coma para búsqueda

  // Autoría y visibilidad
  createdById String
  isShared    Boolean @default(true) // true = visible para todos, false = solo el autor
  usageCount  Int     @default(0) // Cuántas veces se ha usado

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation("InstitutionAchievementBank", fields: [institutionId], references: [id], onDelete: Cascade)
  subject     Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  area        Area?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  grade       Grade?      @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  createdBy   User        @relation("AchievementBankAuthor", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([institutionId, subjectId])
  @@index([institutionId, areaId])
  @@index([institutionId, achievementType])
  @@index([createdById])
}

// ═══════════════════════════════════════════════════════════════════════════
// SISTEMA DE PERMISOS GRANULARES
// ═══════════════════════════════════════════════════════════════════════════

// Catálogo maestro de permisos (definido por el sistema)
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique // Ej: "CONFIG_GRADING_EDIT_SCALE"
  module      String // Ej: "CONFIG_INSTITUTIONAL"
  function    String // Ej: "GRADING_SYSTEM"
  subFunction String // Ej: "EDIT_SCALE"
  name        String // Ej: "Cambiar escala de notas"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RoleBasePermission[]
  userPermissions UserExtraPermission[]
  auditLogs       PermissionAuditLog[]
}

// Permisos base por rol (FIJOS - definidos por el sistema, no editables por Admin)
model RoleBasePermission {
  id           String     @id @default(cuid())
  role         String // "ADMIN_INSTITUTIONAL", "RECTOR", "COORDINADOR", "DOCENTE"
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

// Permisos extra por usuario (temporales o permanentes)
model UserExtraPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation("UserExtraPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Quién otorgó el permiso
  grantedById String
  grantedBy   User     @relation("GrantedPermissions", fields: [grantedById], references: [id])
  grantedAt   DateTime @default(now())

  // Vigencia (null = permanente)
  validFrom DateTime  @default(now())
  validTo   DateTime? // null = sin expiración

  // Metadata
  reason       String // Obligatorio para auditoría
  isActive     Boolean   @default(true)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?     @relation("RevokedPermissions", fields: [revokedById], references: [id])
  revokeReason String?

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([validTo])
}

// Tipos de acciones de auditoría
enum PermissionAuditAction {
  GRANT // Otorgar permiso extra
  REVOKE // Revocar permiso extra
  EXPIRE // Expiración automática
  ROLE_ASSIGN // Asignar rol a usuario
  ROLE_REMOVE // Quitar rol a usuario
  RULE_CHANGE // Cambio de reglas académicas
  PERIOD_OPEN // Apertura de período
  PERIOD_CLOSE // Cierre de período
  WINDOW_OPEN // Apertura de ventana
  WINDOW_CLOSE // Cierre de ventana
}

// Auditoría de permisos (OBLIGATORIA)
model PermissionAuditLog {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // Acción realizada
  action PermissionAuditAction

  // Usuario afectado
  targetUserId String
  targetUser   User   @relation("AuditTarget", fields: [targetUserId], references: [id])

  // Permiso afectado (opcional, para cambios de rol es null)
  permissionId String?
  permission   Permission? @relation(fields: [permissionId], references: [id])

  // Para cambios de rol
  oldRole String?
  newRole String?

  // Quién realizó la acción
  performedById String
  performedBy   User     @relation("AuditPerformer", fields: [performedById], references: [id])
  performedAt   DateTime @default(now())

  // Detalles
  reason    String?
  metadata  Json? // Datos adicionales (fechas, configuraciones, etc.)
  ipAddress String?

  @@index([institutionId, performedAt])
  @@index([targetUserId])
  @@index([action])
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO DE ELECCIONES ESCOLARES
// ═══════════════════════════════════════════════════════════════════════════

// Proceso electoral (agrupa todas las elecciones de un período)
model ElectionProcess {
  id             String @id @default(cuid())
  institutionId  String
  academicYearId String

  name        String // "Elecciones Gobierno Escolar 2026"
  description String?

  // Fechas del proceso general (opcionales en DRAFT, se definen antes de avanzar)
  registrationStart DateTime? // Inicio inscripción candidatos
  registrationEnd   DateTime? // Fin inscripción candidatos
  campaignStart     DateTime? // Inicio campaña
  campaignEnd       DateTime? // Fin campaña
  votingStart       DateTime? // Inicio votación
  votingEnd         DateTime? // Fin votación

  status ElectionProcessStatus @default(DRAFT)

  // Configuración de cargos habilitados
  enablePersonero          Boolean @default(true)
  enableContralor          Boolean @default(true)
  enableRepresentanteGrado Boolean @default(true)
  enableRepresentanteCurso Boolean @default(true)

  // Configuración de votación
  allowBlankVote Boolean @default(true)

  // Enterprise: Soft-lock y seguridad
  isLocked   Boolean   @default(false) // Soft-lock durante VOTING
  lockedAt   DateTime? // Timestamp de bloqueo
  lockedById String? // Quién bloqueó

  // Enterprise: Cierre firmado
  closedAt         DateTime? // Timestamp oficial de cierre
  closedById       String? // Quién cerró
  closureSignature String? // Firma digital del cierre (hash)

  // Enterprise: Integridad verificable
  finalSnapshot Json? // Snapshot de resultados finales
  finalHash     String? // SHA-256 del snapshot

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  institution  Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  createdBy    User               @relation("ElectionProcessCreatedBy", fields: [createdById], references: [id])
  lockedBy     User?              @relation("ElectionProcessLockedBy", fields: [lockedById], references: [id])
  closedBy     User?              @relation("ElectionProcessClosedBy", fields: [closedById], references: [id])
  elections    Election[]
  auditLogs    ElectionAuditLog[]

  @@index([institutionId, academicYearId])
}

enum ElectionProcessStatus {
  DRAFT // Borrador
  REGISTRATION // Inscripción de candidatos
  CAMPAIGN // Campaña electoral
  VOTING // Votación activa
  CLOSED // Cerrada (resultados disponibles)
  CANCELLED // Anulada
}

// Elección específica (Personero, Contralor, Rep. Grado X, Rep. Curso XA)
model Election {
  id                String @id @default(cuid())
  electionProcessId String

  type ElectionType

  // Para representantes de grado/curso, especificar cuál
  gradeId String? // Si es REPRESENTANTE_GRADO
  groupId String? // Si es REPRESENTANTE_CURSO

  // Quiénes pueden votar (si es null, todos los estudiantes activos)
  // Para personero/contralor: todos
  // Para rep. grado: estudiantes del grado
  // Para rep. curso: estudiantes del curso

  status ElectionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  electionProcess ElectionProcess  @relation(fields: [electionProcessId], references: [id], onDelete: Cascade)
  grade           Grade?           @relation(fields: [gradeId], references: [id])
  group           Group?           @relation(fields: [groupId], references: [id])
  candidates      Candidate[]
  votes           Vote[]
  results         ElectionResult[]

  @@unique([electionProcessId, type, gradeId, groupId])
}

enum ElectionType {
  // Elecciones estudiantiles
  PERSONERO // Personero estudiantil (toda la institución)
  CONTRALOR // Contralor estudiantil (toda la institución)
  REPRESENTANTE_GRADO // Representante de grado (por grado)
  REPRESENTANTE_CURSO // Representante de curso (por grupo)

  // Elecciones de docentes
  REPRESENTANTE_DOCENTES // Representante de docentes ante el consejo directivo
  COMITE_CONVIVENCIA_DOC // Representante docente al comité de convivencia
}

enum ElectionStatus {
  ACTIVE // Activa
  CANCELLED // Anulada
}

// Candidato inscrito
model Candidate {
  id         String @id @default(cuid())
  electionId String
  studentId  String

  // Información de campaña
  slogan       String? // Eslogan de campaña
  proposals    String? // Propuestas (texto o HTML)
  photo        String? // Foto de campaña (URL)
  color        String? // Color de campaña (hex)
  ballotNumber Int? // Número en el tarjetón

  // Estado de aprobación
  status          CandidateStatus @default(PENDING)
  rejectionReason String?

  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  election   Election        @relation(fields: [electionId], references: [id], onDelete: Cascade)
  student    Student         @relation(fields: [studentId], references: [id])
  approvedBy User?           @relation("CandidateApprovedBy", fields: [approvedById], references: [id])
  votes      Vote[]
  result     ElectionResult?

  @@unique([electionId, studentId])
}

enum CandidateStatus {
  PENDING // Pendiente de aprobación
  APPROVED // Aprobado
  REJECTED // Rechazado
}

// Voto emitido
model Vote {
  id         String @id @default(cuid())
  electionId String

  // Quién votó (para evitar duplicados, NO se guarda por quién votó públicamente)
  voterId String // ID del estudiante que votó

  // Por quién votó (null = voto en blanco)
  candidateId String?

  votedAt DateTime @default(now())

  election  Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  voter     Student    @relation("VoterVotes", fields: [voterId], references: [id])
  candidate Candidate? @relation(fields: [candidateId], references: [id])

  @@unique([electionId, voterId]) // Un voto por estudiante por elección
  @@index([electionId])
}

// Resultado de elección (calculado al cerrar)
model ElectionResult {
  id          String  @id @default(cuid())
  electionId  String
  candidateId String? @unique // null = votos en blanco

  votes      Int // Total de votos
  percentage Float // Porcentaje
  position   Int // Posición (1°, 2°, 3°...)
  isWinner   Boolean @default(false)

  calculatedAt DateTime @default(now())

  election  Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidate Candidate? @relation(fields: [candidateId], references: [id])

  @@unique([electionId, candidateId])
}

// Log de auditoría electoral inmutable
model ElectionAuditLog {
  id         String  @id @default(cuid())
  processId  String
  electionId String?

  // Acción realizada
  action ElectionAuditAction

  // Quién realizó la acción
  actorId   String? // userId (null para acciones del sistema)
  actorType String // 'USER', 'STUDENT', 'SYSTEM'
  actorIp   String? // IP del actor

  // Datos de la acción (inmutables)
  payload       Json? // Datos relevantes de la acción
  previousState Json? // Estado anterior (para cambios de estado)
  newState      Json? // Nuevo estado

  // Integridad
  checksum      String // SHA-256 del contenido para verificar integridad
  previousLogId String? // Referencia al log anterior (cadena)

  createdAt DateTime @default(now())

  process ElectionProcess @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([electionId])
  @@index([action])
  @@index([createdAt])
}

enum ElectionAuditAction {
  // Proceso
  PROCESS_CREATED
  PROCESS_STATUS_CHANGED
  PROCESS_LOCKED
  PROCESS_CLOSED

  // Candidatos
  CANDIDATE_REGISTERED
  CANDIDATE_APPROVED
  CANDIDATE_REJECTED
  CANDIDATE_UPDATED

  // Votación
  VOTE_CAST
  VOTE_ATTEMPTED_DUPLICATE
  VOTE_ATTEMPTED_INVALID

  // Resultados
  RESULTS_CALCULATED
  RESULTS_SNAPSHOT_CREATED

  // Seguridad
  UNAUTHORIZED_ACCESS_ATTEMPT
  INTEGRITY_CHECK_FAILED
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO DE PAGOS Y EVENTOS FINANCIEROS (OPCIONAL)
// ═══════════════════════════════════════════════════════════════════════════

// Concepto de pago (configurable por institución)
model PaymentConcept {
  id            String   @id @default(cuid())
  institutionId String
  name          String // "Matrícula", "Pensión", "Derecho a grado", etc.
  description   String?
  defaultAmount Decimal? @db.Decimal(12, 2) // Monto base sugerido
  isRecurrent   Boolean  @default(false) // Mensual, anual, etc.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  events      PaymentEvent[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

// Evento de pago (rifa, bingo, prueba semestral, graduación, etc.)
model PaymentEvent {
  id             String  @id @default(cuid())
  institutionId  String
  conceptId      String?
  academicYearId String? // Año lectivo asociado (opcional)

  name        String // "Rifa Navideña 2026", "Derecho a Grado 11°"
  description String?
  amount      Decimal   @db.Decimal(12, 2) // Monto a pagar
  dueDate     DateTime? // Fecha límite de pago

  // Alcance del evento
  scope       PaymentScope @default(INSTITUTION)
  scopeFilter Json? // { gradeIds: [], groupIds: [], shiftId: "" }

  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  institution  Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  concept      PaymentConcept?  @relation(fields: [conceptId], references: [id])
  academicYear AcademicYear?    @relation(fields: [academicYearId], references: [id])
  createdBy    User?            @relation("PaymentEventCreatedBy", fields: [createdById], references: [id])
  payments     StudentPayment[]

  @@index([institutionId])
  @@index([academicYearId])
}

enum PaymentScope {
  INSTITUTION // Toda la institución
  SHIFT // Por jornada
  GRADE // Por grado
  GROUP // Por grupo/curso
  INDIVIDUAL // Estudiantes específicos
}

// Pago de estudiante (relación estudiante-evento)
model StudentPayment {
  id        String @id @default(cuid())
  studentId String
  eventId   String

  // Montos
  totalAmount Decimal @db.Decimal(12, 2) // Monto total a pagar
  paidAmount  Decimal @default(0) @db.Decimal(12, 2) // Monto pagado

  // Estado
  status PaymentStatus @default(PENDING)

  // Descuentos/Exenciones
  discountAmount Decimal? @db.Decimal(12, 2)
  discountReason String?

  observations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event        PaymentEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([studentId, eventId])
  @@index([studentId])
  @@index([eventId])
  @@index([status])
}

enum PaymentStatus {
  PENDING // Sin pagar
  PARTIAL // Pago parcial
  PAID // Pagado completo
  EXEMPT // Exento (beca, descuento 100%)
  OVERDUE // Vencido
}

// Transacción de pago (abonos)
model PaymentTransaction {
  id               String @id @default(cuid())
  studentPaymentId String

  amount        Decimal @db.Decimal(12, 2)
  paymentMethod String? // Efectivo, transferencia, PSE, etc.
  reference     String? // Número de recibo/comprobante

  observations String?
  receivedById String
  receivedAt   DateTime @default(now())

  studentPayment StudentPayment @relation(fields: [studentPaymentId], references: [id], onDelete: Cascade)
  receivedBy     User           @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  @@index([studentPaymentId])
}

// ═══════════════════════════════════════════════════════════════════════════
// DOCUMENTOS INSTITUCIONALES
// ═══════════════════════════════════════════════════════════════════════════

enum InstitutionalDocumentCategory {
  MANUAL // Manuales de convivencia, procedimientos
  REGLAMENTO // Reglamentos institucionales
  FORMATO // Formatos y plantillas
  CIRCULAR // Circulares informativas
  PEI // Proyecto Educativo Institucional
  SIEE // Sistema Institucional de Evaluación
  OTRO // Otros documentos
}

model InstitutionalDocument {
  id            String @id @default(cuid())
  institutionId String

  title       String
  description String?
  category    InstitutionalDocumentCategory

  // Archivo
  fileUrl  String
  fileName String
  fileSize Int // Bytes
  mimeType String

  // Control
  isActive     Boolean @default(true)
  uploadedById String

  // Visibilidad por rol (vacío = todos pueden ver)
  visibleToRoles String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([institutionId])
  @@index([category])
  @@index([isActive])
}

// ═══════════════════════════════════════════════════════════════════════════
// GESTIÓN DE TAREAS DOCENTES
// ═══════════════════════════════════════════════════════════════════════════

enum ManagementArea {
  ACADEMICA // Gestión Académica
  DIRECTIVA // Gestión Directiva
  COMUNITARIA // Gestión Comunitaria
  ADMINISTRATIVA // Gestión Administrativa
}

enum TaskPriority {
  BAJA
  NORMAL
  ALTA
  URGENTE
}

enum TaskCategory {
  PLANEACION // Planeación curricular
  SEGUIMIENTO // Seguimiento académico
  EVIDENCIA // Recolección de evidencias
  REUNION // Reuniones
  CAPACITACION // Capacitaciones
  PROYECTO // Proyectos institucionales
  OTRO // Otros
}

enum TaskAssignmentStatus {
  PENDING // Pendiente
  IN_PROGRESS // En progreso
  SUBMITTED // Entregada (esperando verificación)
  APPROVED // Aprobada
  REJECTED // Rechazada
  CANCELLED // Cancelada
}

// Miembro de un área de gestión (docente asignado a un área por el líder o admin)
model ManagementAreaMember {
  id            String         @id @default(cuid())
  institutionId String
  userId        String // El docente miembro
  area          ManagementArea
  assignedById  String // Quién lo asignó (líder o admin)
  isActive      Boolean        @default(true)

  createdAt DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation("ManagementAreaMemberUser", fields: [userId], references: [id])
  assignedBy  User        @relation("ManagementAreaMemberAssigner", fields: [assignedById], references: [id])

  @@unique([institutionId, userId, area])
  @@index([institutionId])
  @@index([userId])
  @@index([area])
}

// Líder de gestión (docente con rol de liderazgo en un área)
model ManagementLeader {
  id            String         @id @default(cuid())
  institutionId String
  userId        String // El docente que es líder
  area          ManagementArea
  isActive      Boolean        @default(true)
  assignedById  String // Quién lo nombró líder

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user         User             @relation("ManagementLeaderUser", fields: [userId], references: [id])
  assignedBy   User             @relation("ManagementLeaderAssigner", fields: [assignedById], references: [id])
  tasksCreated ManagementTask[] @relation("TaskCreator")

  @@unique([institutionId, userId, area])
  @@index([institutionId])
  @@index([userId])
}

// Tarea de gestión
model ManagementTask {
  id            String @id @default(cuid())
  institutionId String

  title       String
  description String?      @db.Text
  category    TaskCategory
  priority    TaskPriority @default(NORMAL)
  dueDate     DateTime?

  // Quién creó la tarea
  createdById String
  leaderId    String? // Si fue creada por un líder de gestión

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  leader      ManagementLeader? @relation("TaskCreator", fields: [leaderId], references: [id])
  assignments TaskAssignment[]

  @@index([institutionId])
  @@index([createdById])
  @@index([dueDate])
  @@index([priority])
}

// Asignación de tarea a docente
model TaskAssignment {
  id         String @id @default(cuid())
  taskId     String
  assigneeId String // Docente asignado

  status TaskAssignmentStatus @default(PENDING)

  // Respuesta del docente
  startedAt    DateTime?
  completedAt  DateTime?
  responseNote String?   @db.Text

  // Evidencia (archivo)
  evidenceUrl      String?
  evidenceFileName String?
  evidenceFileSize Int?
  evidenceMimeType String?

  // Verificación por coordinador/líder
  verifiedById     String?
  verifiedAt       DateTime?
  verificationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task       ManagementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee   User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  verifiedBy User?          @relation("TaskVerifier", fields: [verifiedById], references: [id])

  @@unique([taskId, assigneeId])
  @@index([taskId])
  @@index([assigneeId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// CONTROL DE ALMACENAMIENTO POR INSTITUCIÓN
// ═══════════════════════════════════════════════════════════════════════════

model InstitutionStorageUsage {
  id            String @id @default(cuid())
  institutionId String @unique

  // Uso actual en bytes
  documentsUsage BigInt @default(0) // Documentos institucionales
  evidencesUsage BigInt @default(0) // Evidencias de tareas
  galleryUsage   BigInt @default(0) // Galería
  otherUsage     BigInt @default(0) // Otros

  // Límites en bytes (0 = sin límite)
  documentsLimit BigInt @default(524288000) // 500 MB default
  evidencesLimit BigInt @default(1073741824) // 1 GB default
  galleryLimit   BigInt @default(104857600) // 100 MB default

  // Última actualización
  lastCalculatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO FINANCIERO Y CONTABLE INSTITUCIONAL
// ═══════════════════════════════════════════════════════════════════════════

// Tipo de tercero financiero
enum ThirdPartyType {
  STUDENT // Estudiante matriculado
  TEACHER // Docente
  GUARDIAN // Acudiente
  GROUP // Grupo completo (cobro masivo)
  GRADE // Grado completo (cobro masivo)
  EXTERNAL // Persona externa
  PROVIDER // Proveedor (para egresos)
}

// Estado de obligación financiera
enum ObligationStatus {
  PENDING // Pendiente de pago
  PARTIAL // Pago parcial
  PAID // Pagado completamente
  CANCELLED // Cancelada/Anulada
  OVERDUE // Vencida
}

// Método de pago
enum PaymentMethod {
  CASH // Efectivo
  TRANSFER // Transferencia bancaria
  CARD // Tarjeta débito/crédito
  CHECK // Cheque
  PSE // PSE (Colombia)
  NEQUI // Nequi
  DAVIPLATA // Daviplata
  OTHER // Otro
}

// Tipo de movimiento financiero
enum FinancialMovementType {
  INCOME // Ingreso (recaudo)
  EXPENSE // Egreso (gasto)
  REFUND // Devolución
  ADJUSTMENT // Ajuste contable
}

// Estado de factura
enum InvoiceStatus {
  DRAFT // Borrador
  ISSUED // Emitida
  PAID // Pagada
  CANCELLED // Anulada
}

// Tercero financiero (cliente/proveedor)
model FinancialThirdParty {
  id            String @id @default(cuid())
  institutionId String

  type        ThirdPartyType
  referenceId String? // ID del student, teacher, group, grade, guardian

  // Datos del tercero (pueden venir de referencia o ser manuales)
  name         String
  document     String?
  documentType DocumentType?
  email        String?
  phone        String?
  address      String?

  // Para proveedores
  businessName    String? // Razón social
  nit             String?
  bankName        String?
  bankAccount     String?
  bankAccountType String? // Ahorros, Corriente

  notes    String? @db.Text
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  obligations FinancialObligation[]
  payments    FinancialPayment[]
  expenses    FinancialExpense[]
  invoices    FinancialInvoice[]

  @@unique([institutionId, type, referenceId])
  @@index([institutionId])
  @@index([type])
  @@index([referenceId])
  @@index([document])
}

// Categoría financiera (clasificación contable)
model FinancialCategory {
  id            String @id @default(cuid())
  institutionId String

  name        String // Eventos, Rifas, Grados, Donaciones, etc.
  description String?
  code        String? // Código contable opcional
  type        FinancialMovementType @default(INCOME) // Si es para ingresos o egresos

  // Presupuesto anual opcional
  budgetAmount Decimal? @db.Decimal(15, 2)

  color String? // Color para UI
  icon  String? // Icono para UI

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  concepts    ChargeConcept[]
  expenses    FinancialExpense[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([type])
}

// Concepto de cobro (plantilla reutilizable)
model ChargeConcept {
  id            String @id @default(cuid())
  institutionId String

  name        String // Bingo institucional, Derecho de grado, etc.
  description String? @db.Text
  categoryId  String

  defaultAmount Decimal @db.Decimal(15, 2)

  // Configuración de cobro
  isMassive     Boolean @default(false) // Permite asignación masiva
  isRecurring   Boolean @default(false) // Es recurrente (mensual, etc.)
  allowPartial  Boolean @default(true) // Permite pagos parciales
  allowDiscount Boolean @default(true) // Permite descuentos

  // Fechas de vigencia
  validFrom  DateTime?
  validUntil DateTime?
  dueDate    DateTime? // Fecha límite de pago por defecto

  // Configuración de mora
  lateFeeType     String? // FIXED, PERCENTAGE
  lateFeeValue    Decimal? @db.Decimal(15, 2)
  gracePeriodDays Int?     @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  category    FinancialCategory     @relation(fields: [categoryId], references: [id])
  obligations FinancialObligation[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([categoryId])
}

// Obligación financiera (cobro asignado a tercero)
model FinancialObligation {
  id            String @id @default(cuid())
  institutionId String

  thirdPartyId String
  conceptId    String

  // Montos
  originalAmount Decimal @db.Decimal(15, 2) // Monto original
  discountAmount Decimal @default(0) @db.Decimal(15, 2) // Descuento aplicado
  lateFeeAmount  Decimal @default(0) @db.Decimal(15, 2) // Mora acumulada
  totalAmount    Decimal @db.Decimal(15, 2) // Total a pagar (original - descuento + mora)
  paidAmount     Decimal @default(0) @db.Decimal(15, 2) // Total pagado
  balance        Decimal @db.Decimal(15, 2) // Saldo pendiente

  status ObligationStatus @default(PENDING)

  // Fechas
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidDate  DateTime? // Fecha de pago completo

  // Descuento
  discountReason     String?
  discountApprovedBy String?

  // Referencia para trazabilidad
  reference String? // Número de referencia único
  notes     String? @db.Text

  // Auditoría
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  thirdParty   FinancialThirdParty    @relation(fields: [thirdPartyId], references: [id])
  concept      ChargeConcept          @relation(fields: [conceptId], references: [id])
  payments     FinancialPayment[]
  invoiceItems FinancialInvoiceItem[]

  @@index([institutionId])
  @@index([thirdPartyId])
  @@index([conceptId])
  @@index([status])
  @@index([dueDate])
  @@index([reference])
}

// Pago/Recaudo (caja)
model FinancialPayment {
  id            String @id @default(cuid())
  institutionId String

  obligationId String? // Puede ser pago a obligación específica
  thirdPartyId String // Quién paga

  amount        Decimal       @db.Decimal(15, 2)
  paymentMethod PaymentMethod

  // Detalles del pago
  receiptNumber  String? // Número de recibo
  transactionRef String? // Referencia de transacción (transferencia, PSE, etc.)

  paymentDate DateTime @default(now())

  notes String? @db.Text

  // PDF interno generado
  pdfUrl           String? // URL del PDF generado (cache)
  pdfGeneratedAt   DateTime? // Fecha de generación del PDF
  verificationHash String? // Hash para verificación QR

  // Auditoría
  receivedById String // Quién recibió el pago
  voidedAt     DateTime? // Si fue anulado
  voidedById   String?
  voidReason   String?

  // Facturación electrónica (futuro - nullable)
  externalInvoiceId  String? // ID de factura en proveedor externo
  cufe               String? // Código Único de Factura Electrónica
  dianStatus         String? // PENDING | ACCEPTED | REJECTED | NOT_APPLICABLE
  electronicProvider String? // Proveedor usado (siigo, alegra, etc.)
  electronicXmlUrl   String? // URL del XML UBL generado
  electronicPdfUrl   String? // URL del PDF legal del proveedor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  obligation  FinancialObligation? @relation(fields: [obligationId], references: [id])
  thirdParty  FinancialThirdParty  @relation(fields: [thirdPartyId], references: [id])
  receivedBy  User                 @relation("PaymentReceivedBy", fields: [receivedById], references: [id])
  voidedBy    User?                @relation("PaymentVoidedBy", fields: [voidedById], references: [id])

  @@unique([institutionId, receiptNumber])
  @@index([institutionId])
  @@index([obligationId])
  @@index([thirdPartyId])
  @@index([paymentDate])
}

// Egreso/Gasto
model FinancialExpense {
  id            String @id @default(cuid())
  institutionId String

  categoryId String
  providerId String? // Tercero proveedor (opcional)

  description String
  amount      Decimal @db.Decimal(15, 2)

  // Detalles
  expenseDate   DateTime  @default(now())
  invoiceNumber String? // Número de factura del proveedor
  invoiceDate   DateTime?

  paymentMethod  PaymentMethod?
  transactionRef String?

  // Documentos soporte
  attachmentUrl  String?
  attachmentName String?

  notes String? @db.Text

  // Auditoría
  registeredById String
  approvedById   String?
  approvedAt     DateTime?

  // Anulación
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  category     FinancialCategory    @relation(fields: [categoryId], references: [id])
  provider     FinancialThirdParty? @relation(fields: [providerId], references: [id])
  registeredBy User                 @relation("ExpenseRegisteredBy", fields: [registeredById], references: [id])
  approvedBy   User?                @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  voidedBy     User?                @relation("ExpenseVoidedBy", fields: [voidedById], references: [id])

  @@index([institutionId])
  @@index([categoryId])
  @@index([providerId])
  @@index([expenseDate])
}

// Factura/Comprobante
model FinancialInvoice {
  id            String @id @default(cuid())
  institutionId String

  thirdPartyId String

  invoiceNumber String // Número de factura
  type          FinancialMovementType // INCOME o EXPENSE
  status        InvoiceStatus         @default(DRAFT)

  // Montos
  subtotal      Decimal @db.Decimal(15, 2)
  discountTotal Decimal @default(0) @db.Decimal(15, 2)
  taxTotal      Decimal @default(0) @db.Decimal(15, 2)
  total         Decimal @db.Decimal(15, 2)

  // Fechas
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  paidDate  DateTime?

  // PDF generado
  pdfUrl         String?
  pdfGeneratedAt DateTime?

  notes String? @db.Text

  // Auditoría
  createdById   String
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  thirdParty  FinancialThirdParty    @relation(fields: [thirdPartyId], references: [id])
  createdBy   User                   @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?                  @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  items       FinancialInvoiceItem[]

  @@unique([institutionId, invoiceNumber])
  @@index([institutionId])
  @@index([thirdPartyId])
  @@index([status])
  @@index([issueDate])
}

// Ítem de factura
model FinancialInvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  obligationId String? // Referencia a obligación si aplica

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(15, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  tax         Decimal @default(0) @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice    FinancialInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  obligation FinancialObligation? @relation(fields: [obligationId], references: [id])

  @@index([invoiceId])
  @@index([obligationId])
}

// Configuración financiera de la institución
model FinancialSettings {
  id            String @id @default(cuid())
  institutionId String @unique

  // Numeración
  invoicePrefix     String @default("FAC")
  invoiceNextNumber Int    @default(1)
  receiptPrefix     String @default("REC")
  receiptNextNumber Int    @default(1)

  // Configuración de mora
  defaultLateFeeType     String? // FIXED, PERCENTAGE
  defaultLateFeeValue    Decimal? @db.Decimal(15, 2)
  defaultGracePeriodDays Int      @default(5)

  // Modo de facturación
  billingMode String @default("INTERNAL_ONLY") // INTERNAL_ONLY | EXTERNAL_ELECTRONIC_PROVIDER

  // Datos fiscales / DIAN
  taxId            String? // NIT de la institución
  businessName     String? // Razón social completa
  taxRegime        String? // RESPONSABLE_IVA | NO_RESPONSABLE | REGIMEN_SIMPLE
  ciiu             String? // Código CIIU actividad económica
  economicActivity String? // Descripción actividad económica

  // Resolución de facturación DIAN (preparación)
  invoiceResolution       String? // "Resolución DIAN No. 18764..."
  invoiceResolutionDate   DateTime? // Fecha de resolución
  invoiceResolutionPrefix String? // Prefijo autorizado (ej: "SETT")
  invoiceRangeFrom        Int? // Numeración autorizada desde
  invoiceRangeTo          Int? // Numeración autorizada hasta

  // Configuración visual del documento
  invoiceLogoUrl          String? // URL del logo/escudo institucional
  invoicePageSize         String  @default("HALF_LETTER") // Media carta (5.5" x 8.5")
  invoicePrimaryColor     String? @default("#1E40AF") // Color primario bordes/encabezados
  invoiceSecondaryColor   String? @default("#F0F9FF") // Color secundario fondo
  invoiceFooterText       String? @db.Text // Texto legal pie de página
  invoiceShowQR           Boolean @default(true) // Mostrar QR en documento
  invoiceShowBankAccounts Boolean @default(true) // Mostrar cuentas bancarias

  // Datos de contacto para documentos
  invoiceCity    String? // Ciudad
  invoiceAddress String? // Dirección completa
  invoicePhone   String? // Teléfono
  invoiceEmail   String? // Email

  // Cuentas bancarias
  bankAccounts Json? // Array de cuentas bancarias

  // Delegación de recaudo
  allowTeacherCollection Boolean @default(false) // Permite a docentes registrar pagos

  // Notificaciones
  sendPaymentReminders Boolean @default(true)
  reminderDaysBefore   Int     @default(3)

  // Proveedor electrónico (futuro)
  electronicProvider    String? // Nombre del proveedor (siigo, alegra, loggro, etc.)
  electronicProviderKey String? // API Key del proveedor (encriptada)
  electronicProviderUrl String? // URL base del proveedor

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

// Cierre de caja diario
model CashRegisterClose {
  id            String @id @default(cuid())
  institutionId String

  closeDate DateTime @db.Date

  // Totales del día
  cashTotal     Decimal @default(0) @db.Decimal(15, 2)
  transferTotal Decimal @default(0) @db.Decimal(15, 2)
  cardTotal     Decimal @default(0) @db.Decimal(15, 2)
  otherTotal    Decimal @default(0) @db.Decimal(15, 2)
  grandTotal    Decimal @default(0) @db.Decimal(15, 2)

  // Conteo físico (para arqueo)
  physicalCash Decimal? @db.Decimal(15, 2)
  difference   Decimal? @db.Decimal(15, 2)

  notes String? @db.Text

  closedById String
  closedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  closedBy    User        @relation(fields: [closedById], references: [id])

  @@unique([institutionId, closeDate])
  @@index([institutionId])
  @@index([closeDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// MÓDULO DE TIMETABLING (HORARIOS ESCOLARES)
// ═══════════════════════════════════════════════════════════════════════════

// Modo de organización del horario (configurable por grado)
enum ScheduleMode {
  FIXED_TEACHER // Docente fijo (preescolar, primaria baja): mismo docente todo el día
  ROTATING_TEACHER // Rotación de docentes (4°-5° primaria, secundaria, media)
}

// Tipo de bloque de tiempo
enum TimeBlockType {
  CLASS // Clase regular
  BREAK // Descanso/recreo
  LUNCH // Almuerzo
  ASSEMBLY // Formación/acto cívico
  FREE // Libre/disponible
  TUTORING // Tutoría/dirección de grupo
}

// Día de la semana
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// Tipo de restricción de espacio
enum RoomRestrictionType {
  PREFERRED // Preferido (prioridad pero no exclusivo)
  EXCLUSIVE // Exclusivo (solo esta materia puede usarlo)
}

// Bloque de tiempo (estructura de la jornada, mismos bloques aplican a todos los días)
model TimeBlock {
  id            String @id @default(cuid())
  institutionId String
  shiftId       String

  type      TimeBlockType @default(CLASS)
  startTime String // "07:00" formato HH:mm
  endTime   String // "07:45" formato HH:mm
  order     Int // Orden visual (1, 2, 3...)
  label     String? // "Bloque 1", "Descanso", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  shift           Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  scheduleEntries ScheduleEntry[]

  @@unique([institutionId, shiftId, order])
  @@index([institutionId])
  @@index([shiftId])
}

// Espacio/Aula (recurso configurable, NO atado a materia por defecto)
model Room {
  id            String  @id @default(cuid())
  institutionId String
  campusId      String?

  name         String // "Laboratorio de Ciencias", "Cancha", "Aula 201"
  code         String? // Código corto "LAB-1", "AUL-201"
  capacity     Int? // Capacidad máxima
  description  String?
  equipment    String[] // ["proyector", "microscopios", "computadores"]
  isReservable Boolean  @default(true)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution     Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus          Campus?           @relation(fields: [campusId], references: [id], onDelete: SetNull)
  scheduleEntries ScheduleEntry[]
  restrictions    RoomRestriction[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([campusId])
}

// Restricción de espacio (OPCIONAL - la institución decide si activar)
model RoomRestriction {
  id            String              @id @default(cuid())
  institutionId String
  roomId        String
  subjectId     String? // Asignatura (null = restricción general)
  type          RoomRestrictionType @default(PREFERRED)

  createdAt DateTime @default(now())

  institution Institution @relation("RlsInstitutionRR", fields: [institutionId], references: [id])
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  subject     Subject?    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([roomId, subjectId])
}

// Configuración de horario por grado (modo configurable POR GRADO, no por nivel)
model ScheduleGradeConfig {
  id             String @id @default(cuid())
  institutionId  String
  academicYearId String
  gradeId        String

  mode ScheduleMode @default(ROTATING_TEACHER)

  // Restricciones blandas (preferencias de optimización)
  maxConsecutiveHours Int? // Máximo horas seguidas de una misma materia
  preferDistribution  Boolean @default(true) // Distribuir horas en la semana
  avoidHeavyLastHours Boolean @default(false) // Evitar materias pesadas en última hora
  allowDoubleBlocks   Boolean @default(true) // Permitir bloques dobles (lab, arte)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  grade        Grade        @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([institutionId, academicYearId, gradeId])
  @@index([institutionId])
  @@index([academicYearId])
}

// Disponibilidad del docente (OPCIONAL - para restricciones de horario)
model TeacherAvailability {
  id             String @id @default(cuid())
  institutionId  String
  academicYearId String
  teacherId      String

  dayOfWeek   DayOfWeek
  startTime   String // "07:00"
  endTime     String // "14:00"
  isAvailable Boolean   @default(true) // true = disponible, false = no disponible
  reason      String? // "Otra institución", "Permiso médico", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  teacher      User         @relation("TeacherScheduleAvailability", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([institutionId, academicYearId, teacherId, dayOfWeek, startTime])
  @@index([institutionId])
  @@index([teacherId])
  @@index([academicYearId])
}

// Entrada de horario (la celda en la grilla visual)
model ScheduleEntry {
  id             String    @id @default(cuid())
  institutionId  String
  academicYearId String
  groupId        String
  timeBlockId    String
  dayOfWeek      DayOfWeek

  // Clase regular (apunta a TeacherAssignment que ya tiene docente+materia+grupo)
  teacherAssignmentId String?

  // Proyecto transversal (alternativa a clase regular)
  projectName        String? // "Proyecto PRAE", "Proyecto de Democracia"
  projectDescription String?

  // Espacio asignado (opcional, configurable)
  roomId String?

  // Metadata
  notes String?
  color String? // Color personalizado para la UI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution       Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  group             Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  timeBlock         TimeBlock          @relation(fields: [timeBlockId], references: [id], onDelete: Cascade)
  teacherAssignment TeacherAssignment? @relation(fields: [teacherAssignmentId], references: [id], onDelete: SetNull)
  room              Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([groupId, timeBlockId, dayOfWeek]) // Un grupo: una sola entrada por bloque+día
  @@index([institutionId])
  @@index([academicYearId])
  @@index([groupId])
  @@index([timeBlockId])
  @@index([teacherAssignmentId])
  @@index([roomId])
  @@index([dayOfWeek])
}

// Contexto persistente de generación de horarios (uno por institución+año+jornada)
model ScheduleGenerationContext {
  id             String @id @default(cuid())
  institutionId  String
  academicYearId String
  shiftId        String

  // Último paso alcanzado en el flujo del generador
  lastStep String @default("load") // load | configure | generate | result

  // Parámetros de configuración de jornada (independientes por shift)
  startTime               String? // "06:30"
  classesPerDay           Int? // 7
  classDurationMinutes    Int? // 55
  breakDurationMinutes    Int? // 15
  breakAfterBlock         Int? // 2
  secondBreakAfterBlock   Int? // 0 = sin segundo receso
  includeLunch            Boolean  @default(true)
  lunchDurationMinutes    Int? // 30
  lunchAfterBlock         Int? // 6
  includeTutoring         Boolean  @default(false)
  tutoringDurationMinutes Int? // 55
  activeDays              String[] // ["MONDAY","TUESDAY",...]

  // Opciones de generación
  clearExisting       Boolean  @default(true)
  respectAvailability Boolean  @default(true)
  groupTeacherBlocks  Boolean  @default(true)
  selectedGroupIds    String[] // IDs de grupos seleccionados (vacío = todos del shift)

  // Resultado de última generación (snapshot para mostrar al reabrir)
  lastGenerationResult Json? // GenerationResult serializado

  // Indica si la configuración de bloques ya fue guardada para este shift
  configSaved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  shift        Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([institutionId, academicYearId, shiftId])
  @@index([institutionId])
  @@index([academicYearId])
  @@index([shiftId])
}

// ═══════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN DE BOLETINES ACADÉMICOS
// ═══════════════════════════════════════════════════════════════════════════

model ReportCardConfig {
  id            String @id @default(cuid())
  institutionId String @unique

  // Encabezado
  showLogo           Boolean @default(true)
  showShield         Boolean @default(false)
  logoUrl            String? // URL del escudo/logo institucional para el boletín
  headerResolution   String?
  headerMunicipality String?
  headerDepartment   String?

  // Colores personalizables
  primaryColor String? @default("#1E3A8A") // Color primario (encabezados, barras)

  // Tipo de evaluación — DEPRECADO: el sistema lo deduce de academicStructure del nivel
  // Se mantiene por compatibilidad con datos existentes, pero NO se usa para decidir layout
  evaluationType       String  @default("NUMERIC") // DEPRECADO — ignorado por ReportCardEngine
  showNumericGrade     Boolean @default(true)
  showPerformanceLevel Boolean @default(true)
  showAchievements     Boolean @default(true)
  showRecommendations  Boolean @default(true)

  // Mensaje motivacional
  showMotivationalMsg   Boolean @default(true)
  motivationalMsgType   String  @default("AUTO") // AUTO, CUSTOM, NONE
  customMotivationalTpl String?

  // Contenido
  showAttendance     Boolean @default(true)
  showRanking        Boolean @default(true)
  showObservations   Boolean @default(true)
  showAreaAverages   Boolean @default(true)
  showGeneralAverage Boolean @default(true)
  showScale          Boolean @default(true)
  showRecoveryGrades Boolean @default(true)
  showComponents     Boolean @default(false) // Desglose por componentes (Saber, Hacer, Ser)

  // Firmas configurables — JSON array
  // [{"role":"RECTOR","label":"Rector(a)","name":"NOMBRE","enabled":true,"signatureImageUrl":"..."}]
  // Para Director de Grupo: role="DIRECTOR_GRUPO", imageUrl se toma de User.signatureImageUrl del tutor
  signatureConfig Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution @relation("ReportCardConfigInstitution", fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
}

// ═══════════════════════════════════════════════════════════════════════════
// CAPABILITIES DE VISUALIZACIÓN POR ROL E INSTITUCIÓN
// Controla qué puede ver cada rol (reportes, horarios, etc.)
// El admin puede configurar por institución
// ═══════════════════════════════════════════════════════════════════════════

model InstitutionRoleCapability {
  id            String   @id @default(cuid())
  institutionId String
  role          String // "DOCENTE", "DOCENTE_TUTOR", "COORDINADOR", etc.
  capabilityKey String // "VIEW_OWN_SCHEDULE", "VIEW_TUTOR_GROUP_REPORTS", etc.
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation("InstitutionRoleCapabilities", fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, role, capabilityKey])
  @@index([institutionId])
  @@index([institutionId, role])
}

// ═══════════════════════════════════════════════════════════════════════════
// ACOMPAÑAMIENTO PEDAGÓGICO DIFERENCIAL (APD) / PIAR
// Planes de apoyo pedagógico para estudiantes de TODOS los niveles.
// NO modifica notas, NO recalcula promedios, NO impacta promoción.
// Cumplimiento: Decreto 1421 de 2017 (PIAR obligatorio).
// Fase 1: Sin integración IA. Preparado para Fase 2 (IA desacoplada).
// ═══════════════════════════════════════════════════════════════════════════

enum SupportPlanType {
  APD // Acompañamiento Pedagógico Diferencial (general)
  PIAR // Plan Individual de Ajustes Razonables (Decreto 1421)
}

enum AdjustmentType {
  CURRICULAR // Ajuste curricular
  METHODOLOGICAL // Ajuste metodológico
  EVALUATIVE // Ajuste evaluativo
  COMMUNICATION // Ajuste comunicativo
  ENVIRONMENTAL // Ajuste ambiental/físico
}

enum PlanParticipantRole {
  TEACHER // Docente
  COUNSELOR // Orientador/Psicólogo
  COORDINATOR // Coordinador
  FAMILY_MEMBER // Acudiente/Familiar
  EXTERNAL_SPECIALIST // Especialista externo
}

enum SupportDocumentType {
  EVIDENCE // Evidencia pedagógica
  FAMILY_DOCUMENT // Documento familiar (consentimiento, actas)
  ASSESSMENT // Valoración/diagnóstico
  REPORT // Informe de seguimiento
}

model PedagogicalSupportPlan {
  id                  String  @id @default(uuid())
  institutionId       String
  studentEnrollmentId String
  achievementId       String? // dimensión específica (opcional)
  academicTermId      String
  supportProfileId    String? // Vínculo con perfil APD (opcional para planes legacy)

  // PIAR: tipo de plan (APD general o PIAR formal Decreto 1421)
  planType SupportPlanType @default(APD)

  supportStrategy  String    @db.Text
  familyCommitment String?   @db.Text
  followUpDate     DateTime?
  observations     String?   @db.Text

  // APD Fase 1: campos extendidos
  objectives            Json? // Array de objetivos SMART [{objective, indicator, evaluationMethod, expectedAchievement}]
  adaptationStrategies  Json? // Estrategias de adaptación curricular
  evaluationAdjustments Json? // Ajustes evaluativos razonables
  progressPercentage    Decimal? @db.Decimal(5, 2) // 0.00–100.00 calculado automáticamente

  // PIAR: firma y aprobación familiar (Decreto 1421)
  planApprovedByFamily Boolean   @default(false)
  familyApprovalDate   DateTime?
  familySignatureUrl   String? // URL del documento de firma escaneado

  // Versionado de planes (trazabilidad legal)
  version        Int     @default(1)
  previousPlanId String? // FK al plan anterior (si es versión > 1)

  status SupportStatus @default(ACTIVE)

  // Trazabilidad de cierre
  completedAt   DateTime?
  completedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution       Institution                @relation("RlsInstitutionPSP", fields: [institutionId], references: [id])
  studentEnrollment StudentEnrollment          @relation(fields: [studentEnrollmentId], references: [id])
  achievement       Achievement?               @relation(fields: [achievementId], references: [id])
  academicTerm      AcademicTerm               @relation(fields: [academicTermId], references: [id])
  completedBy       User?                      @relation("PedagogicalSupportCompletedBy", fields: [completedById], references: [id])
  supportProfile    EducationalSupportProfile? @relation(fields: [supportProfileId], references: [id])
  previousPlan      PedagogicalSupportPlan?    @relation("PlanVersionHistory", fields: [previousPlanId], references: [id])
  newerVersions     PedagogicalSupportPlan[]   @relation("PlanVersionHistory")

  // APD: relaciones con actividades, logs, participantes, asignaturas y documentos
  activities   SupportActivity[]
  progressLogs SupportProgressLog[]
  participants SupportPlanParticipant[]
  planSubjects SupportPlanSubject[]
  documents    SupportDocument[]

  @@index([institutionId])
  @@index([studentEnrollmentId])
  @@index([academicTermId])
  @@index([status])
  @@index([supportProfileId])
  @@index([planType])
  @@index([previousPlanId])
}

// ═══════════════════════════════════════════════════════════════════════════
// PERFIL DE ACOMPAÑAMIENTO EDUCATIVO
// Separa información pedagógica del diagnóstico clínico.
// Gestiona consentimiento parental (Decreto 1421 de 2017).
// ═══════════════════════════════════════════════════════════════════════════

model EducationalSupportProfile {
  id            String @id @default(uuid())
  institutionId String
  studentId     String

  supportCategory   String // Texto legacy (se mantiene por compatibilidad)
  supportCategoryId String? // FK a SupportCategory (categorías configurables por institución)
  pedagogicalNotes  String? @db.Text

  // Diagnóstico pedagógico (caracterización inicial requerida por PIAR)
  learningBarriers          String? @db.Text // Barreras para el aprendizaje identificadas
  strengths                 String? @db.Text // Fortalezas del estudiante
  supportNeeds              String? @db.Text // Necesidades de apoyo específicas
  learningStyleObservations String? @db.Text // Observaciones sobre estilo de aprendizaje

  // Consentimiento parental obligatorio
  parentConsentAccepted Boolean   @default(false)
  consentDate           DateTime?
  consentDocumentUrl    String?

  active Boolean @default(false) // No se puede activar sin consentimiento

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution              @relation("RlsInstitutionESP", fields: [institutionId], references: [id])
  student      Student                  @relation(fields: [studentId], references: [id])
  categoryRef  SupportCategory?         @relation(fields: [supportCategoryId], references: [id])
  supportPlans PedagogicalSupportPlan[]
  observations StudentObservation[]     @relation("ObservationSupportProfile")

  @@unique([institutionId, studentId]) // Un perfil por estudiante por institución
  @@index([institutionId])
  @@index([studentId])
  @@index([active])
  @@index([supportCategoryId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ACTIVIDADES DE ACOMPAÑAMIENTO
// Seguimiento granular de actividades dentro de un plan pedagógico.
// ═══════════════════════════════════════════════════════════════════════════

enum AdaptationLevel {
  LOW
  MEDIUM
  HIGH
}

enum ActivityCompletionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model SupportActivity {
  id            String @id @default(uuid())
  supportPlanId String

  topic                       String
  originalActivityDescription String?                  @db.Text
  teacherFinalActivity        String?                  @db.Text
  adaptationLevel             AdaptationLevel          @default(MEDIUM)
  adjustmentType              AdjustmentType? // Tipo de ajuste razonable (PIAR)
  completionStatus            ActivityCompletionStatus @default(PENDING)
  teacherFeedback             String?                  @db.Text
  studentPerformanceScore     Int? // 0–100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supportPlan PedagogicalSupportPlan @relation(fields: [supportPlanId], references: [id], onDelete: Cascade)

  @@index([supportPlanId])
  @@index([completionStatus])
}

// ═══════════════════════════════════════════════════════════════════════════
// LOG DE PROGRESO DE ACOMPAÑAMIENTO
// Historial cualitativo y cuantitativo de seguimiento.
// ═══════════════════════════════════════════════════════════════════════════

model SupportProgressLog {
  id            String @id @default(uuid())
  supportPlanId String

  progressIndicator      Int // 1–5
  qualitativeObservation String? @db.Text

  createdById String
  createdAt   DateTime @default(now())

  supportPlan PedagogicalSupportPlan @relation(fields: [supportPlanId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("SupportProgressLogCreatedBy", fields: [createdById], references: [id])

  @@index([supportPlanId])
  @@index([createdById])
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDITORÍA DEL MÓDULO APD
// Registra toda acción sobre perfiles, planes y consultas.
// ═══════════════════════════════════════════════════════════════════════════

enum ApdAuditAction {
  PROFILE_CREATED
  PROFILE_UPDATED
  PROFILE_ACTIVATED
  PROFILE_DEACTIVATED
  PROFILE_VIEWED
  PLAN_CREATED
  PLAN_UPDATED
  PLAN_STATUS_CHANGED
  PLAN_PROGRESS_UPDATED
  ACTIVITY_CREATED
  ACTIVITY_UPDATED
  PROGRESS_LOG_CREATED
}

model ApdAuditLog {
  id            String         @id @default(uuid())
  institutionId String
  userId        String
  action        ApdAuditAction
  entityType    String // "EducationalSupportProfile" | "PedagogicalSupportPlan" | "SupportActivity" | "SupportProgressLog"
  entityId      String
  details       Json? // Datos adicionales del cambio
  ipAddress     String?

  createdAt DateTime @default(now())

  institution Institution @relation("RlsInstitutionApdAudit", fields: [institutionId], references: [id])
  user        User        @relation("ApdAuditLogUser", fields: [userId], references: [id])

  @@index([institutionId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// CATEGORÍAS DE ACOMPAÑAMIENTO CONFIGURABLES
// Reemplaza las categorías hardcodeadas en frontend.
// Cada institución puede definir sus propias categorías.
// ═══════════════════════════════════════════════════════════════════════════

model SupportCategory {
  id            String  @id @default(uuid())
  institutionId String
  name          String // Ej: "Ritmo de aprendizaje", "Barrera comunicativa"
  description   String? @db.Text
  active        Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution Institution                 @relation("RlsInstitutionSupportCat", fields: [institutionId], references: [id])
  profiles    EducationalSupportProfile[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([active])
}

// ═══════════════════════════════════════════════════════════════════════════
// PARTICIPANTES DEL PLAN (Equipo Interdisciplinario PIAR)
// Decreto 1421: requiere docente, orientador, familia, directivo.
// Permite registrar quién participó y firmas.
// ═══════════════════════════════════════════════════════════════════════════

model SupportPlanParticipant {
  id            String              @id @default(uuid())
  supportPlanId String
  userId        String? // FK a User (null si es familiar/externo sin cuenta)
  role          PlanParticipantRole
  fullName      String? // Nombre completo (para familiares/externos sin cuenta)
  relationship  String? // Relación con el estudiante (ej: "Madre", "Terapeuta")
  signed        Boolean             @default(false)
  signedAt      DateTime?
  signatureUrl  String? // URL de firma escaneada/digital
  observations  String?             @db.Text

  createdAt DateTime @default(now())

  supportPlan PedagogicalSupportPlan @relation(fields: [supportPlanId], references: [id], onDelete: Cascade)
  user        User?                  @relation("SupportPlanParticipants", fields: [userId], references: [id])

  @@unique([supportPlanId, userId, role]) // Un usuario no puede tener el mismo rol dos veces en un plan
  @@index([supportPlanId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ASIGNATURAS VINCULADAS AL PLAN
// Permite que un plan de acompañamiento se aplique a múltiples asignaturas,
// con docente responsable por cada una.
// ═══════════════════════════════════════════════════════════════════════════

model SupportPlanSubject {
  id            String  @id @default(uuid())
  supportPlanId String
  subjectId     String // FK a Subject (catálogo de asignaturas)
  teacherId     String? // FK a User (docente responsable de esa asignatura)
  specificNotes String? @db.Text // Notas específicas para esta asignatura

  createdAt DateTime @default(now())

  supportPlan PedagogicalSupportPlan @relation(fields: [supportPlanId], references: [id], onDelete: Cascade)
  subject     Subject                @relation("SupportPlanSubjects", fields: [subjectId], references: [id])
  teacher     User?                  @relation("SupportPlanSubjectTeacher", fields: [teacherId], references: [id])

  @@unique([supportPlanId, subjectId])
  @@index([supportPlanId])
  @@index([subjectId])
  @@index([teacherId])
}

// ═══════════════════════════════════════════════════════════════════════════
// DOCUMENTOS DE SOPORTE
// Archivos adjuntos: evidencias, documentos familiares, valoraciones, informes.
// ═══════════════════════════════════════════════════════════════════════════

model SupportDocument {
  id            String              @id @default(uuid())
  supportPlanId String
  uploadedById  String
  type          SupportDocumentType
  fileName      String
  fileUrl       String // URL en storage (Cloudflare R2)
  description   String?

  createdAt DateTime @default(now())

  supportPlan PedagogicalSupportPlan @relation(fields: [supportPlanId], references: [id], onDelete: Cascade)
  uploadedBy  User                   @relation("SupportDocumentUploader", fields: [uploadedById], references: [id])

  @@index([supportPlanId])
  @@index([type])
}

// ═══════════════════════════════════════════════════════════════════════════
// TEACHER WORKSPACE (Espacio privado del docente)
// Módulo completamente aislado del core académico.
// Todo es privado por defecto (visible solo por teacherId).
// ═══════════════════════════════════════════════════════════════════════════

enum WorkspaceBoardType {
  KANBAN
  CLASS_LOG
  STUDENT_NOTES
  CHECKLIST
  MICRO_COLLECT
  CLASSROOM_ROLES
  PROJECT
}

enum WorkspaceVisibility {
  PRIVATE
  SHARED_COORDINATOR
  SHARED_ADMIN
}

enum WorkspaceItemStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum WorkspaceScopeType {
  GROUP
  GRADE
  MULTI_GROUP
}

// WORKSPACE_V2 — nuevo enum polimórfico para items
enum WorkspaceItemKind {
  NOTE
  TASK
  OBSERVATION
  LOG
  COLLECTION
  IDEA
  LIST
  FILE
  EVENT
}

model WorkspaceBoard {
  id             String              @id @default(cuid())
  teacherId      String
  institutionId  String
  academicYearId String?
  groupId        String?
  gradeId        String?
  type           WorkspaceBoardType
  scopeType      WorkspaceScopeType?
  title          String
  description    String?
  color          String?
  metadata       Json?
  visibility     WorkspaceVisibility @default(PRIVATE)
  sharedAt       DateTime?
  startDate      DateTime?
  endDate        DateTime?
  sortOrder      Int                 @default(0)
  isArchived     Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // WORKSPACE_V2 — campos de personalización visual y organización
  emoji          String? // Emoji/icono del espacio (📐, 🚀, etc.)
  coverImage     String? // URL de portada opcional
  bannerColor    String? // Color secundario para gradiente con `color`
  isPinned       Boolean   @default(false) // Fijado en home del docente
  isPersonal     Boolean   @default(false) // True para el "Espacio personal" (uno por docente)
  linkedClassId  String? // Vínculo con horario oficial (clase/materia)
  hiddenSections String[]  @default([]) // Pestañas ocultas por desuso
  lastAccessedAt DateTime? // Para sort por reciente en home

  // F0 — espacio como contenedor de curso con módulos bajo demanda
  enabledModules String[] @default([]) // módulos activados manualmente
  isCourseSpace  Boolean  @default(false) // marca de espacio-curso (multi-módulo)

  teacher            User                      @relation("WorkspaceBoards", fields: [teacherId], references: [id], onDelete: Cascade)
  institution        Institution               @relation("RlsInstitutionWB", fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear?             @relation(fields: [academicYearId], references: [id])
  group              Group?                    @relation(fields: [groupId], references: [id])
  grade              Grade?                    @relation("WorkspaceBoardGrade", fields: [gradeId], references: [id])
  columns            WorkspaceColumn[]
  items              WorkspaceItem[]
  events             WorkspaceEvent[]
  followUps          WorkspaceFollowUp[]
  activities         WorkspaceActivity[]
  collections        WorkspaceCollection[]
  roles              WorkspaceRole[]
  resources          WorkspaceResource[]
  resourceFolders    WorkspaceResourceFolder[]
  projects           WorkspaceProject[]
  pedagogicalDesigns PedagogicalDesign[]       @relation("BoardPedagogicalDesigns")

  @@index([teacherId, institutionId])
  @@index([teacherId, type])
  @@index([institutionId, visibility])
  @@index([gradeId])
  @@index([startDate, endDate])
  @@index([teacherId, isPinned])
  @@index([teacherId, lastAccessedAt(sort: Desc)])
}

model WorkspaceColumn {
  id        String  @id @default(cuid())
  boardId   String
  title     String
  sortOrder Int     @default(0)
  color     String?

  board WorkspaceBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  items WorkspaceItem[]

  @@index([boardId])
}

model WorkspaceItem {
  id         String              @id @default(cuid())
  boardId    String
  columnId   String?
  studentId  String?
  title      String
  content    String?             @db.Text
  metadata   Json?
  status     WorkspaceItemStatus @default(TODO)
  dueDate    DateTime?
  eventDate  DateTime?
  sortOrder  Int                 @default(0)
  isArchived Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  // WORKSPACE_V2 — modelo polimórfico de elementos de organización
  kind            WorkspaceItemKind? // NOTE | TASK | OBSERVATION | LOG | COLLECTION | IDEA | LIST | FILE | EVENT
  completedAt     DateTime? // Cuando se cierra/marca como hecho
  amount          Decimal?           @db.Decimal(12, 2) // Meta de recaudo (si kind=COLLECTION)
  amountCollected Decimal?           @db.Decimal(12, 2) // Monto efectivamente recaudado
  tags            String[]           @default([]) // Tags libres
  // F5 — Bitácora: tipo de entrada y destacado
  entryType       String? // clase|reunion|idea|llamada|incidente|otro
  isImportant     Boolean            @default(false)

  board   WorkspaceBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column  WorkspaceColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  student User?            @relation("WorkspaceItemStudent", fields: [studentId], references: [id])

  @@index([boardId, columnId])
  @@index([boardId, status])
  @@index([boardId, studentId])
  @@index([dueDate])
  @@index([eventDate])
  @@index([boardId, kind])
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKSPACE V2 · F0 — Capas transversales (Calendario, Seguimientos,
// Actividad, Favoritos, Dashboard configurable). Todo privado del docente,
// no toca el core académico. Ver docs/MI_ESPACIO_DOCENTE_MASTER.md §24.
// ═══════════════════════════════════════════════════════════════════════════

enum WorkspaceEventType {
  REMINDER
  MEETING
  DEADLINE
  ACTIVITY
  OTHER
}

enum WorkspaceFollowUpStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum WorkspaceFollowUpSource {
  OBSERVATION
  BITACORA
  PROJECT
  COLLECTION
  TASK
  MANUAL
}

enum WorkspaceFavoriteType {
  BOARD
  ITEM
  PROJECT
  RESOURCE
  FOLLOWUP
  COLLECTION
}

// Calendario — eventos opcionales que cualquier registro puede crear.
model WorkspaceEvent {
  id            String             @id @default(cuid())
  institutionId String
  teacherId     String
  boardId       String?
  itemId        String? // referencia blanda al registro de origen
  title         String
  date          DateTime
  allDay        Boolean            @default(true)
  type          WorkspaceEventType @default(REMINDER)
  done          Boolean            @default(false)
  isArchived    Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  board WorkspaceBoard? @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([teacherId, date])
  @@index([boardId])
  @@index([itemId])
}

// Seguimientos — motor del dashboard. Cualquier módulo puede generarlos.
model WorkspaceFollowUp {
  id            String                  @id @default(cuid())
  institutionId String
  teacherId     String
  boardId       String?
  sourceType    WorkspaceFollowUpSource @default(MANUAL)
  sourceItemId  String? // referencia blanda al origen
  studentId     String?
  title         String
  notes         String?
  dueDate       DateTime?
  status        WorkspaceFollowUpStatus @default(OPEN)
  isArchived    Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  resolvedAt    DateTime?

  board WorkspaceBoard? @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([teacherId, status])
  @@index([boardId])
  @@index([dueDate])
  @@index([sourceItemId])
}

// Actividad — columna vertebral de Timeline, Actividad reciente e Inteligencia.
// Append-only e indexada (evita UNION sobre múltiples tablas).
model WorkspaceActivity {
  id            String   @id @default(cuid())
  institutionId String
  teacherId     String
  boardId       String?
  verb          String // created | updated | completed | paid | assigned | archived
  entityType    String // ENTRY | TASK | EVENT | FOLLOWUP | COLLECTION | ROLE | RESOURCE | PROJECT | BOARD
  entityId      String?
  summary       String
  createdAt     DateTime @default(now())

  board WorkspaceBoard? @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
  @@index([boardId, createdAt])
}

// Favoritos — polimórfico. Acceso rápido a lo importante.
model WorkspaceFavorite {
  id         String                @id @default(cuid())
  teacherId  String
  entityType WorkspaceFavoriteType
  entityId   String
  createdAt  DateTime              @default(now())

  @@unique([teacherId, entityType, entityId])
  @@index([teacherId])
}

// Dashboard configurable por docente (widgets: visibilidad, orden, tamaño).
model WorkspaceDashboardConfig {
  id        String   @id @default(cuid())
  teacherId String   @unique
  widgets   Json // [{ key, visible, order, size }]
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKSPACE V2 · F6 — Recaudo (sub-dominio relacional)
// Meta = unitValue × nº de cargos (calculada, nunca manual). Pagos parciales
// e historial. Privado del docente, no toca finanzas oficiales.
// ═══════════════════════════════════════════════════════════════════════════

model WorkspaceCollection {
  id            String    @id @default(cuid())
  boardId       String
  institutionId String
  name          String
  description   String?
  unitValue     Decimal   @db.Decimal(12, 2)
  dueDate       DateTime?
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  board   WorkspaceBoard              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  charges WorkspaceCollectionCharge[]

  @@index([boardId])
}

model WorkspaceCollectionCharge {
  id           String   @id @default(cuid())
  collectionId String
  studentId    String // Student.id — sin FK forzada (workspace desacoplado), solo índice
  studentName  String // denormalizado para mostrar sin joins al core
  status       String   @default("PENDING") // PENDING | PARTIAL | PAID (derivado, se persiste para consulta)
  createdAt    DateTime @default(now())

  collection WorkspaceCollection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  payments   WorkspaceCollectionPayment[]

  @@index([collectionId])
  @@index([studentId])
}

model WorkspaceCollectionPayment {
  id       String   @id @default(cuid())
  chargeId String
  amount   Decimal  @db.Decimal(12, 2)
  paidAt   DateTime @default(now())
  note     String?

  charge WorkspaceCollectionCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKSPACE V2 · F7 — Roles del salón (catálogo + asignaciones con historial)
// Privado del docente. No toca convivencia oficial.
// ═══════════════════════════════════════════════════════════════════════════

model WorkspaceRole {
  id            String   @id @default(cuid())
  boardId       String
  institutionId String
  name          String
  isCustom      Boolean  @default(false)
  createdAt     DateTime @default(now())

  board       WorkspaceBoard            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignments WorkspaceRoleAssignment[]

  @@index([boardId])
}

model WorkspaceRoleAssignment {
  id           String    @id @default(cuid())
  roleId       String
  studentId    String
  studentName  String
  studentPhoto String?
  assignedAt   DateTime  @default(now())
  removedAt    DateTime? // null = activo; con valor = historial

  role WorkspaceRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([studentId])
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKSPACE V2 · F9 — Biblioteca (repositorio de recursos del docente)
// Independiente de los adjuntos inline. Carpetas, etiquetas, favoritos,
// versionado. Privado del docente.
// ═══════════════════════════════════════════════════════════════════════════

model WorkspaceResourceFolder {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  board     WorkspaceBoard      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  resources WorkspaceResource[]

  @@index([boardId])
}

model WorkspaceResource {
  id            String   @id @default(cuid())
  boardId       String
  institutionId String
  ownerId       String
  folderId      String?
  name          String
  type          String   @default("FILE") // FILE | LINK | VIDEO
  url           String
  storageKey    String? // key en el bucket (para URL firmada / borrado)
  mimeType      String?
  sizeBytes     Int?
  version       Int      @default(1)
  tags          String[] @default([])
  isFavorite    Boolean  @default(false)
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  board  WorkspaceBoard           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  folder WorkspaceResourceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([boardId])
  @@index([folderId])
}

// ═══════════════════════════════════════════════════════════════════════════
// WORKSPACE V2 · F10 — Proyecto (entidad de primer nivel, ver MASTER §22)
// Contenedor con ciclo de vida propio. Tareas/comentarios/evidencias se
// implementan reusando primitivas (tablas hijas mínimas).
// ═══════════════════════════════════════════════════════════════════════════

model WorkspaceProject {
  id            String    @id @default(cuid())
  boardId       String
  institutionId String
  name          String
  objective     String?
  competencies  String?
  status        String    @default("PLANNING") // PLANNING | ACTIVE | DONE | ARCHIVED
  progress      Int       @default(0) // 0–100
  startDate     DateTime?
  endDate       DateTime?
  isFavorite    Boolean   @default(false)
  isArchived    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  board   WorkspaceBoard           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks   WorkspaceProjectTask[]
  members WorkspaceProjectMember[]

  @@index([boardId])
}

model WorkspaceProjectTask {
  id        String    @id @default(cuid())
  projectId String
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  project WorkspaceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model WorkspaceProjectMember {
  id          String   @id @default(cuid())
  projectId   String
  studentId   String
  studentName String
  addedAt     DateTime @default(now())

  project WorkspaceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════════════════
// DISEÑO PEDAGÓGICO IA ("Estudio") — Activo Pedagógico Vivo (APV)
// E0: cimientos. El contenido vive como JSON versionado; el ADN va en `dna`.
// docs/DISENO_PEDAGOGICO_IA.md
// ═══════════════════════════════════════════════════════════════════════════

enum PedagogicalExperienceType {
  LESSON_PLAN
  SEQUENCE
  PBL // Proyecto ABP
  STEAM
  FLIPPED // Clase invertida
  CHALLENGE // Aprendizaje basado en retos
  WORKSHOP // Taller
  LAB // Laboratorio
  EVALUATION
  INTERACTIVE_LESSON // Lección interactiva
  UNIT // Unidad completa
}

enum PedagogicalDesignStatus {
  DRAFT
  IN_USE
  EVALUATED
  IMPROVABLE
  ARCHIVED
}

enum PedagogicalVisibility {
  PRIVATE
  AREA
  INSTITUTION
}

model PedagogicalDesign {
  id                   String                    @id @default(cuid())
  teacherId            String
  institutionId        String
  boardId              String? // Curso (WorkspaceBoard) donde vive; null = personal
  subjectId            String?
  gradeId              String?
  groupId              String?
  experienceType       PedagogicalExperienceType @default(LESSON_PLAN)
  title                String
  summary              String?                   @db.Text
  status               PedagogicalDesignStatus   @default(DRAFT)
  visibility           PedagogicalVisibility     @default(PRIVATE)
  dna                  Json? // ADN pedagógico (§24): tema, competencias, bloom, metodología…
  sourceDesignId       String? // Linaje si fue clonado de otro diseño
  aiProviderUsed       String? // Trazabilidad de costo de IA
  aiModelUsed          String?
  aiTokens             Int?
  currentVersionNumber Int                       @default(1)
  isArchived           Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  board    WorkspaceBoard?            @relation("BoardPedagogicalDesigns", fields: [boardId], references: [id], onDelete: Cascade)
  versions PedagogicalDesignVersion[]

  @@index([teacherId, institutionId])
  @@index([boardId])
  @@index([institutionId, visibility])
}

model PedagogicalDesignVersion {
  id               String   @id @default(cuid())
  designId         String
  versionNumber    Int
  content          Json // Objeto estructurado del APV (momentos, actividades, evaluación…)
  changeNote       String?  @db.Text
  createdByAi      Boolean  @default(false)
  evidenceSnapshot Json? // Señales que motivaron esta versión (ciclo de evidencia)
  createdAt        DateTime @default(now())

  design PedagogicalDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, versionNumber])
  @@index([designId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ORQUESTADOR DE IA — plan por institución (free/premium), cuota y consumo.
// docs/DISENO_PEDAGOGICO_IA.md §21
// ═══════════════════════════════════════════════════════════════════════════

enum AiTier {
  FREE // modelos gratis (OpenRouter cascade) — validación / plan básico
  PREMIUM // modelo de pago (ej. Gemini Flash) — instituciones que pagan
  BYOK // la institución trae su propia API key
}

model InstitutionAiPlan {
  id                  String   @id @default(cuid())
  institutionId       String   @unique
  tier                AiTier   @default(FREE)
  modelOverride       String? // forzar un modelo concreto (opcional)
  monthlyTokenQuota   Int      @default(2000000) // tope mensual de tokens
  tokensUsedThisMonth Int      @default(0)
  periodResetAt       DateTime @default(now()) // inicio del período de cuota
  byokApiKeyRef       String? // referencia a key propia (futuro)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([institutionId])
}

// ═══════════════════════════════════════════════════════════════════════════
// AULA VIRTUAL — Módulo de clases virtuales por asignatura
// ═══════════════════════════════════════════════════════════════════════════

enum MaterialType {
  DOCUMENT
  VIDEO_YOUTUBE
  VIDEO_UPLOAD
  LINK
  TEXT
  IMAGE
}

enum ClassroomActivityType {
  TASK
  QUIZ
  FORUM
  GAME
  EXAM
  LIVE_QUIZ
  HOME_QUIZ
  ICFES_SIMULATOR
  SELF_ASSESSMENT // Autoevaluación actitudinal
  PEER_ASSESSMENT // Coevaluación actitudinal
  LESSON // Lección interactiva con slides y actividades
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  FILL_BLANK
  ORDERING
  MATCHING
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
  LATE
  AUTO_GRADED
}

model Classroom {
  id                  String   @id @default(cuid())
  institutionId       String
  teacherAssignmentId String   @unique
  title               String
  description         String?  @db.Text
  coverImage          String?
  color               String?
  isActive            Boolean  @default(true)
  ownerUserId         String? // Edusyn Play: dueño personal (null en modo institucional)
  isPersonal          Boolean  @default(false) // Shortcut para queries de Edusyn Play
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  institution       Institution             @relation("RlsInstitutionCR", fields: [institutionId], references: [id])
  teacherAssignment TeacherAssignment       @relation("ClassroomAssignment", fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  sections          ClassroomSection[]
  announcements     ClassroomAnnouncement[]
  activities        ClassroomActivity[]
  forumPosts        ForumPost[]             @relation("ClassroomForumPosts")
  liveSessions      LiveSession[]
  learningRoutes    LearningRoute[]
  abpProjects       AbpProject[]

  @@index([institutionId])
  @@index([teacherAssignmentId])
  @@index([ownerUserId])
  @@index([isPersonal])
}

model ClassroomSection {
  id          String   @id @default(cuid())
  classroomId String
  title       String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())

  classroom  Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  materials  ClassroomMaterial[]
  activities ClassroomActivity[]

  @@index([classroomId])
}

model ClassroomMaterial {
  id        String       @id @default(cuid())
  sectionId String
  type      MaterialType
  title     String
  content   String?      @db.Text
  fileUrl   String?
  sortOrder Int          @default(0)
  isVisible Boolean      @default(true)
  createdAt DateTime     @default(now())

  section ClassroomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

model ClassroomAnnouncement {
  id             String   @id @default(cuid())
  classroomId    String
  authorId       String
  title          String
  content        String   @db.Text
  isPinned       Boolean  @default(false)
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  author    User      @relation("ClassroomAnnouncementAuthor", fields: [authorId], references: [id])

  @@index([classroomId])
}

model ClassroomActivity {
  id          String                @id @default(cuid())
  sectionId   String? // Nullable para permitir actividades huérfanas al borrar sección
  classroomId String
  type        ClassroomActivityType
  title       String
  description String?               @db.Text

  maxScore         Decimal?  @db.Decimal(7, 2)
  dueDate          DateTime?
  openDate         DateTime?
  timeLimitMinutes Int?
  allowLateSubmit  Boolean   @default(false)
  maxAttempts      Int       @default(1)
  shuffleQuestions Boolean   @default(false)
  showResults      Boolean   @default(true)

  syncToGradebook    Boolean @default(false)
  gradebookComponent String?
  gradebookIndex     Int?

  isVisible          Boolean   @default(true)
  isPublished        Boolean   @default(false)
  scheduledPublishAt DateTime?
  publishedAt        DateTime?
  sortOrder          Int       @default(0)
  // Actividad "propia de una ruta": creada dentro de un paso, se OCULTA de la
  // pestaña Actividades; el estudiante la hace desde el mapa de la ruta.
  isRouteScoped      Boolean   @default(false)
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  section          ClassroomSection?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  classroom        Classroom            @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  questions        ActivityQuestion[]
  contexts         QuestionContext[]
  submissions      ActivitySubmission[]
  forumPosts       ForumPost[]
  assignedStudents ActivityAssignment[]

  // Si está vacío, la actividad es para todos. Si tiene registros, solo para esos estudiantes.
  isRestrictedToAssigned Boolean       @default(false)
  liveSessions           LiveSession[]

  // Evaluación Actitudinal
  rubricId               String? // Rúbrica asociada (para SELF_ASSESSMENT, PEER_ASSESSMENT)
  rubric                 AttitudinalRubric?      @relation("ActivityRubric", fields: [rubricId], references: [id], onDelete: SetNull)
  attitudinalSubmissions AttitudinalSubmission[]
  peerAssessmentPairs    PeerAssessmentPair[]

  // Lección interactiva
  lesson Lesson?

  // Actividades de misión ABP que usan esta actividad como lección/juego jugable
  abpMissionActivities AbpMissionActivity[] @relation("AbpMissionActivityLesson")

  // Pasos de ruta que referencian esta actividad
  routeSteps LearningRouteStep[] @relation("ActivityRouteSteps")

  @@index([classroomId])
  @@index([sectionId])
  @@index([dueDate])
}

// Asignación de actividades a estudiantes específicos (recuperación, refuerzo, etc.)
model ActivityAssignment {
  id                  String   @id @default(cuid())
  activityId          String
  studentEnrollmentId String
  createdAt           DateTime @default(now())

  activity          ClassroomActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentEnrollmentId])
  @@index([activityId])
  @@index([studentEnrollmentId])
}

// Contexto compartido por varias preguntas (texto de lectura, imagen, enunciado)
model QuestionContext {
  id         String  @id @default(cuid())
  activityId String
  title      String? // Título opcional del contexto
  text       String? @db.Text // Texto/pasaje de lectura
  imageUrl   String? // Imagen del contexto
  viewPolicy String  @default("ALWAYS") // ONCE = solo antes de responder, ALWAYS = disponible durante las preguntas
  sortOrder  Int     @default(0)

  activity  ClassroomActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  questions ActivityQuestion[]

  @@index([activityId])
}

model ActivityQuestion {
  id                String       @id @default(cuid())
  activityId        String
  contextId         String?
  type              QuestionType
  text              String       @db.Text
  imageUrl          String?
  options           Json?
  correctAnswer     String?      @db.Text
  points            Decimal      @default(1.0) @db.Decimal(7, 2)
  explanation       String?      @db.Text
  wrongExplanations Json?
  subjectArea       String?
  competency        String?
  sortOrder         Int          @default(0)

  // Per-question time limit (seconds). If null, uses session-level timeLimitOverride.
  timeLimitSeconds Int?

  activity    ClassroomActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  context     QuestionContext?    @relation(fields: [contextId], references: [id], onDelete: SetNull)
  answers     QuestionAnswer[]
  liveAnswers LiveSessionAnswer[]

  @@index([activityId])
  @@index([contextId])
}

model ActivitySubmission {
  id                  String           @id @default(cuid())
  activityId          String
  studentEnrollmentId String
  attemptNumber       Int              @default(1)
  status              SubmissionStatus @default(DRAFT)

  content String? @db.Text
  fileUrl String?

  score      Decimal?  @db.Decimal(7, 2)
  feedback   String?   @db.Text
  gradedAt   DateTime?
  gradedById String?

  startedAt        DateTime?
  submittedAt      DateTime?
  timeSpentSeconds Int?

  syncedToGradebook Boolean @default(false)
  partialGradeId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity          ClassroomActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation("ClassroomSubmissions", fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  gradedBy          User?             @relation("ClassroomGradedSubmissions", fields: [gradedById], references: [id])
  answers           QuestionAnswer[]

  @@unique([activityId, studentEnrollmentId, attemptNumber])
  @@index([activityId])
  @@index([studentEnrollmentId])
}

model QuestionAnswer {
  id              String   @id @default(cuid())
  submissionId    String
  questionId      String
  answer          String?  @db.Text
  selectedOptions Json?
  isCorrect       Boolean?
  pointsEarned    Decimal? @db.Decimal(7, 2)

  submission ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   ActivityQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model ForumPost {
  id          String   @id @default(cuid())
  classroomId String?
  activityId  String?
  authorId    String
  parentId    String?
  title       String?
  content     String   @db.Text
  isAnonymous Boolean  @default(false)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classroom Classroom?         @relation("ClassroomForumPosts", fields: [classroomId], references: [id], onDelete: Cascade)
  activity  ClassroomActivity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author    User               @relation("ForumPostAuthor", fields: [authorId], references: [id])
  parent    ForumPost?         @relation("ForumReplies", fields: [parentId], references: [id])
  replies   ForumPost[]        @relation("ForumReplies")

  @@index([classroomId])
  @@index([activityId])
  @@index([authorId])
}

// ==================== LIVE QUIZ (Kahoot-like) ====================

enum LiveSessionStatus {
  WAITING
  ACTIVE
  FINISHED
}

enum LiveSessionMode {
  INDIVIDUAL
  TEAM
}

enum LiveSessionDeliveryMode {
  SYNC
  ASYNC_HOME
}

// Modo de invitados para sesiones en vivo (Edusyn Play)
enum GuestMode {
  DISABLED // Solo matriculados (comportamiento actual)
  MIXED // Matriculados + invitados con código
  GUESTS_ONLY // Solo invitados (modo Edusyn Play puro)
}

model LiveSession {
  id                  String                  @id @default(cuid())
  classroomId         String
  teacherId           String
  activityId          String
  status              LiveSessionStatus       @default(WAITING)
  mode                LiveSessionMode         @default(INDIVIDUAL)
  deliveryMode        LiveSessionDeliveryMode @default(SYNC)
  parentSessionId     String?
  studentEnrollmentId String?
  currentQuestionIdx  Int                     @default(-1)
  config              Json? // { bonusQuestions: [idx], multipliers: {idx: 2}, timeLimitOverride: 15 }
  // Edusyn Play: invitados vía código público
  joinCode            String?                 @unique // Código de 6 dígitos para /join
  guestMode           GuestMode               @default(DISABLED)
  publicUrl           String? // URL pública para compartir
  guestsCount         Int                     @default(0) // Contador rápido
  createdAt           DateTime                @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?

  classroom         Classroom                @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teacher           User                     @relation("LiveSessionTeacher", fields: [teacherId], references: [id])
  activity          ClassroomActivity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  parentSession     LiveSession?             @relation("LiveSessionParent", fields: [parentSessionId], references: [id], onDelete: SetNull)
  childSessions     LiveSession[]            @relation("LiveSessionParent")
  studentEnrollment StudentEnrollment?       @relation(fields: [studentEnrollmentId], references: [id], onDelete: SetNull)
  answers           LiveSessionAnswer[]
  teams             LiveSessionTeam[]
  participants      LiveSessionParticipant[]

  @@index([classroomId, status])
  @@index([teacherId])
  @@index([parentSessionId])
  @@index([studentEnrollmentId])
  @@index([deliveryMode, status])
  @@index([joinCode])
}

model LiveSessionAnswer {
  id                  String   @id @default(cuid())
  sessionId           String
  questionId          String
  studentEnrollmentId String
  teamId              String?
  answer              String   @db.Text
  isCorrect           Boolean  @default(false)
  responseTimeMs      Int      @default(0)
  points              Float    @default(0)
  answeredAt          DateTime @default(now())

  session           LiveSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question          ActivityQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  team              LiveSessionTeam?  @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([sessionId, questionId, studentEnrollmentId])
  @@index([sessionId, questionId])
}

model LiveSessionTeam {
  id        String @id @default(cuid())
  sessionId String
  name      String
  color     String @default("#6366f1")

  session LiveSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  members LiveSessionTeamMember[]
  answers LiveSessionAnswer[]

  @@index([sessionId])
}

model LiveSessionTeamMember {
  id                  String @id @default(cuid())
  teamId              String
  studentEnrollmentId String

  team              LiveSessionTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentEnrollmentId])
}

// Tracks every student that has ever joined a Live Quiz session. Persists avatar
// selection and connection metadata so the ranking display is stable across
// server restarts, SSE reconnects and session resets.
model LiveSessionParticipant {
  id                  String   @id @default(cuid())
  sessionId           String
  studentEnrollmentId String
  avatarId            String?
  joinedAt            DateTime @default(now())
  lastSeenAt          DateTime @default(now())

  session           LiveSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentEnrollmentId])
  @@index([sessionId])
}

// ═══════════════════════════════════════════════════════════════════════════
// EVALUACIÓN ACTITUDINAL (Autoevaluación, Coevaluación, Heteroevaluación)
// Rúbricas configurables por institución para procesos actitudinales
// ═══════════════════════════════════════════════════════════════════════════

enum AttitudinalRubricType {
  SELF_ASSESSMENT // Autoevaluación (estudiante se evalúa a sí mismo)
  PEER_ASSESSMENT // Coevaluación (estudiante evalúa a compañeros)
  TEACHER_ASSESSMENT // Heteroevaluación (docente evalúa actitud del estudiante)
}

// Rúbrica institucional para evaluación actitudinal
model AttitudinalRubric {
  id            String                @id @default(cuid())
  institutionId String
  name          String // "Rúbrica de Autoevaluación P1", "Coevaluación Trabajo en Equipo"
  description   String?
  type          AttitudinalRubricType
  targetProcess String? // Nombre del subproceso actitudinal al que aplica (ej: "Autoevaluación")
  isDefault     Boolean               @default(false) // Rúbrica por defecto para este tipo
  isActive      Boolean               @default(true)
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  institution Institution             @relation("InstitutionAttitudinalRubrics", fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User?                   @relation("AttitudinalRubricCreator", fields: [createdById], references: [id], onDelete: SetNull)
  criteria    AttitudinalCriterion[]
  activities  ClassroomActivity[]     @relation("ActivityRubric")
  submissions AttitudinalSubmission[]

  @@unique([institutionId, name])
  @@index([institutionId, type])
  @@index([institutionId, isDefault])
}

// Criterio de evaluación dentro de una rúbrica
model AttitudinalCriterion {
  id          String  @id @default(cuid())
  rubricId    String
  name        String // "Responsabilidad", "Trabajo en equipo", "Puntualidad"
  description String? // Descripción detallada del criterio
  weight      Int     @default(100) // Peso porcentual (suma de todos = 100)
  order       Int     @default(0)

  rubric    AttitudinalRubric              @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels    CriterionLevel[]
  responses AttitudinalCriterionResponse[]

  @@index([rubricId])
}

// Niveles de desempeño para cada criterio (escala de valoración)
model CriterionLevel {
  id          String  @id @default(cuid())
  criterionId String
  score       Decimal @db.Decimal(3, 1) // Valor numérico (ej: 5.0, 4.0, 3.0, 2.0, 1.0)
  label       String // "Siempre", "Casi siempre", "A veces", "Rara vez", "Nunca"
  description String? // Descripción de qué significa este nivel
  order       Int     @default(0)

  criterion AttitudinalCriterion           @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  responses AttitudinalCriterionResponse[]

  @@index([criterionId])
}

// Envío de evaluación actitudinal (autoevaluación o coevaluación)
model AttitudinalSubmission {
  id                    String    @id @default(cuid())
  activityId            String
  rubricId              String
  evaluatorEnrollmentId String // Quien evalúa
  targetEnrollmentId    String? // A quien evalúa (null si es autoevaluación)
  reflection            String?   @db.Text // Reflexión o justificación del estudiante
  calculatedScore       Decimal?  @db.Decimal(3, 2) // Nota calculada según pesos
  syncedToGradebook     Boolean   @default(false)
  syncedAt              DateTime?
  submittedAt           DateTime  @default(now())

  activity            ClassroomActivity              @relation(fields: [activityId], references: [id], onDelete: Cascade)
  rubric              AttitudinalRubric              @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  evaluatorEnrollment StudentEnrollment              @relation("AttitudinalEvaluator", fields: [evaluatorEnrollmentId], references: [id], onDelete: Cascade)
  targetEnrollment    StudentEnrollment?             @relation("AttitudinalTarget", fields: [targetEnrollmentId], references: [id], onDelete: Cascade)
  responses           AttitudinalCriterionResponse[]

  @@unique([activityId, evaluatorEnrollmentId, targetEnrollmentId])
  @@index([activityId])
  @@index([evaluatorEnrollmentId])
  @@index([targetEnrollmentId])
}

// Respuesta individual a cada criterio de la rúbrica
model AttitudinalCriterionResponse {
  id           String @id @default(cuid())
  submissionId String
  criterionId  String
  levelId      String // Nivel seleccionado

  submission AttitudinalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterion  AttitudinalCriterion  @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  level      CriterionLevel        @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criterionId])
  @@index([submissionId])
}

// Asignación de pares para coevaluación
model PeerAssessmentPair {
  id                    String    @id @default(cuid())
  activityId            String
  evaluatorEnrollmentId String // Quien debe evaluar
  targetEnrollmentId    String // A quien debe evaluar
  isCompleted           Boolean   @default(false)
  completedAt           DateTime?
  createdAt             DateTime  @default(now())

  activity            ClassroomActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evaluatorEnrollment StudentEnrollment @relation("PeerEvaluator", fields: [evaluatorEnrollmentId], references: [id], onDelete: Cascade)
  targetEnrollment    StudentEnrollment @relation("PeerTarget", fields: [targetEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([activityId, evaluatorEnrollmentId, targetEnrollmentId])
  @@index([activityId])
  @@index([evaluatorEnrollmentId])
}

// ==================== STAFF LEAVE REQUESTS (PERMISOS) ====================

enum StaffLeaveType {
  AUSENCIA // Día completo
  SALIDA_TEMPRANA // Sale antes de hora
  LLEGADA_TARDE // Llega después de hora
  PERMISO_ESPECIAL // Cita médica, calamidad, etc.
}

enum StaffLeaveStatus {
  PENDING // Pendiente de revisión
  APPROVED // Aprobado
  REJECTED // Rechazado
  CANCELLED // Cancelado por el solicitante
}

model StaffLeaveRequest {
  id            String           @id @default(cuid())
  institutionId String
  requesterId   String
  type          StaffLeaveType
  startDate     DateTime         @db.Date
  endDate       DateTime?        @db.Date
  startTime     String? // HH:mm para SALIDA_TEMPRANA/LLEGADA_TARDE
  endTime       String? // HH:mm para SALIDA_TEMPRANA/LLEGADA_TARDE
  reason        String
  attachmentUrl String? // Soporte adjunto (key de R2)
  status        StaffLeaveStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewerNote  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution Institution @relation("RlsInstitutionSLR", fields: [institutionId], references: [id])
  requester   User        @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([institutionId, status])
  @@index([requesterId])
  @@index([startDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// LECCIONES INTERACTIVAS
// ═══════════════════════════════════════════════════════════════════════════

enum LessonSlideType {
  CONTENT // Texto rico + multimedia
  ACTIVITY // Mini-quiz embebido
  CHECKPOINT // Marcador de progreso seguro
  BADGE_REVEAL // Último slide: insignia + celebración
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Modo de reproducción de Lección
enum LessonPlayMode {
  SCORM // Auto-avance, cada estudiante a su ritmo (actual)
  LIVE // Presentación sincronizada estilo Nearpod (Edusyn Play)
}

model Lesson {
  id               String         @id @default(cuid())
  activityId       String         @unique // 1:1 con ClassroomActivity tipo LESSON
  title            String
  description      String?        @db.Text
  coverImage       String?
  badgeEmoji       String?        @default("🏆")
  badgeTitle       String?        @default("Lección completada")
  badgeColor       String?        @default("#8B5CF6")
  estimatedMinutes Int? // Tiempo estimado de la lección
  playMode         LessonPlayMode @default(SCORM) // SCORM auto-avance o LIVE sincronizada
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  activity     ClassroomActivity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  slides       LessonSlide[]
  progress     LessonProgress[]
  liveSessions LiveLessonSession[]

  @@index([activityId])
}

model LessonSlide {
  id        String          @id @default(cuid())
  lessonId  String
  type      LessonSlideType
  sortOrder Int             @default(0)

  // CONTENT slide data
  title    String?
  body     String? @db.Text // HTML rico
  imageUrl String?
  videoUrl String?
  audioUrl String?
  layout   String? @default("text-left-image-right") // layout hint

  // ACTIVITY slide data (JSON con pregunta embebida)
  activityData Json?
  // { questionType, question, options[], correctAnswer, explanation, points, hint }

  // BADGE_REVEAL data
  badgeEmoji String?
  badgeTitle String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([lessonId, sortOrder])
}

model LessonProgress {
  id                  String               @id @default(cuid())
  lessonId            String
  studentEnrollmentId String
  status              LessonProgressStatus @default(NOT_STARTED)
  currentSlideIndex   Int                  @default(0)
  completedSlides     Json? // Array de slide IDs completados
  answers             Json? // { slideId: { answer, isCorrect, points } }
  score               Decimal              @default(0) @db.Decimal(7, 2)
  maxScore            Decimal              @default(0) @db.Decimal(7, 2)
  badgeEarned         Boolean              @default(false)
  lastCheckpointIndex Int                  @default(0) // Último checkpoint alcanzado
  startedAt           DateTime?
  completedAt         DateTime?
  timeSpentSeconds    Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  lesson            Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation("LessonProgressEnrollment", fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentEnrollmentId])
  @@index([lessonId])
  @@index([studentEnrollmentId])
}

// ═══════════════════════════════════════════════════════════════════════════
// GAMIFICACIÓN — Identidad de Aprendizaje (LearningIdentity)
// Capa transversal y agnóstica de materia. XP por DOMINIO (no por clics):
// se gana al demostrar aprendizaje (completar lección, acertar checkpoint…),
// nunca por avanzar. Anclada en Student para persistir entre años/matrículas
// (portafolio longitudinal). Progreso privado por defecto.
// docs/PROPUESTA_UNIFICADA_RUTAS_BILINGUE.md §13 (Paso 1)
// ═══════════════════════════════════════════════════════════════════════════

model LearningIdentity {
  id               String    @id @default(cuid())
  institutionId    String
  studentId        String    @unique
  totalXp          Int       @default(0)
  level            Int       @default(1)
  currentStreak    Int       @default(0) // días consecutivos con actividad
  longestStreak    Int       @default(0)
  lastActivityDate DateTime? // fecha (día) de la última actividad, para la racha
  skillXp          Json? // XP agregado por habilidad/materia: { "Matemáticas": 120 }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  institution Institution          @relation("RlsInstitutionLI", fields: [institutionId], references: [id])
  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  xpEvents    XpEvent[]
  badgeAwards LearningBadgeAward[]

  @@index([institutionId])
  @@index([studentId])
}

// Ledger append-only de concesiones de XP. Idempotente por idempotencyKey
// (ej. "lesson:<lessonId>:complete:<enrollmentId>") para no conceder dos veces.
model XpEvent {
  id                  String   @id @default(cuid())
  institutionId       String
  identityId          String
  studentId           String
  studentEnrollmentId String? // contexto de la matrícula donde ocurrió (opcional)
  source              XpSource
  skill               String? // materia/habilidad; CEFR en el futuro (Paso 2)
  amount              Int
  reason              String? // texto legible: "Lección completada: El ciclo del agua"
  idempotencyKey      String   @unique
  createdAt           DateTime @default(now())

  institution Institution      @relation("RlsInstitutionXPE", fields: [institutionId], references: [id])
  identity    LearningIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([institutionId, createdAt])
  @@index([identityId])
  @@index([studentId])
}

enum XpSource {
  LESSON_COMPLETE // completar una lección
  LESSON_ACTIVITY // acertar una actividad/checkpoint dentro de una lección
  QUIZ_GRADED // quiz calificado
  PLAY // EdusynPlay
  MANUAL // ajuste manual del docente
  ABP // aporte/avance en una Expedición ABP
}

// Insignia ganada por un estudiante. El catálogo de insignias vive en código
// (badge-catalog.ts) — aquí solo se registra qué código ganó y cuándo. Progreso
// privado (nunca ranking público). Permanente: una vez ganada, no se pierde.
model LearningBadgeAward {
  id            String   @id @default(cuid())
  institutionId String
  identityId    String
  studentId     String
  badgeCode     String // referencia al catálogo estático de insignias
  earnedAt      DateTime @default(now())

  institution Institution      @relation("RlsInstitutionLBA", fields: [institutionId], references: [id])
  identity    LearningIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeCode]) // idempotente: una insignia por estudiante
  @@index([institutionId])
  @@index([identityId])
}

// ═══════════════════════════════════════════════════════════════════════════
// GRAFO DE COMPETENCIAS — columna vertebral del aprendizaje (Paso 2)
// Referencia GLOBAL y canónica (no tenant-scoped): el CEFR es el mismo para
// todas las instituciones. Diseño agnóstico de framework para soportar CEFR
// hoy y DBA/Saber (MEN) mañana. Resuelve el cold-start del grafo: viene
// pre-cargado, el docente no lo construye.
// docs/PROPUESTA_UNIFICADA_RUTAS_BILINGUE.md §1 y §13 (Paso 2)
// ═══════════════════════════════════════════════════════════════════════════

model Competency {
  id        String   @id @default(cuid())
  framework String // "CEFR" (futuro: "DBA", "SABER")
  level     String? // CEFR: "A1".."C2"
  skill     String? // CEFR: "READING"|"LISTENING"|"SPEAKING"|"WRITING"
  code      String   @unique // ej. "CEFR.A2.SPEAKING.01"
  statement String   @db.Text // can-do statement ("Puedo describir a mi familia…")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rutas/pasos que apuntan a esta competencia (grafo → aprendizaje)
  targetedByRoutes LearningRoute[]      @relation("RouteTargetCompetency")
  routeSteps       LearningRouteStep[]  @relation("StepCompetency")
  evidence         CompetencyEvidence[] @relation("CompetencyEvidence")

  @@index([framework, level, skill])
  @@index([framework])
}

// Evidencia de que un estudiante demostró (parcial o totalmente) un can-do.
// El corazón de la tesis "todo genera evidencia": cada trabajo enganchado a una
// competencia produce una fila aquí; el dominio (%) se deriva de la evidencia
// acumulada. Tenant-scoped (RLS). docs/PROPUESTA_UNIFICADA_RUTAS_BILINGUE.md §4
model CompetencyEvidence {
  id                  String   @id @default(cuid())
  institutionId       String
  studentId           String
  studentEnrollmentId String?
  competencyId        String
  source              String // "QUIZ" | "LESSON" | "ACTIVITY" | "WRITING" | "MANUAL"
  sourceRef           String? // id de la actividad/entrega que la produjo
  routeStepId         String? // paso de ruta que la originó (si aplica)
  score               Int // 0-100: qué tan bien demostrada
  idempotencyKey      String   @unique
  createdAt           DateTime @default(now())

  institution Institution @relation("RlsInstitutionCEV", fields: [institutionId], references: [id])
  competency  Competency  @relation("CompetencyEvidence", fields: [competencyId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([studentId, competencyId])
  @@index([competencyId])
  @@index([routeStepId])
}

// ═══════════════════════════════════════════════════════════════════════════
// RUTAS DE APRENDIZAJE (Learning Journeys) — Paso 2, increment 2
// La unidad de trabajo deja de ser la actividad suelta: es una RUTA de pasos
// que converge en una competencia. Cada paso ES una ClassroomActivity existente.
// Tenant-scoped (vive en un aula). docs/PROPUESTA_UNIFICADA_RUTAS_BILINGUE.md §2
// ═══════════════════════════════════════════════════════════════════════════

model LearningRoute {
  id                 String   @id @default(cuid())
  institutionId      String
  classroomId        String
  title              String
  description        String?  @db.Text
  targetCompetencyId String? // competencia CEFR objetivo (grafo global)
  targetLevel        String? // "A2" (denormalizado para mostrar)
  // Indicaciones del docente y material base: Valeria los usa al armar la ruta
  // Y los REUSA al generar la lección de cada paso (coherencia en toda la ruta).
  instructions       String?  @db.Text // "cómo" quiere el docente que se genere
  sourceMaterial     String?  @db.Text // documento/guía base pegada por el docente
  isPublished        Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  institution      Institution         @relation("RlsInstitutionLR", fields: [institutionId], references: [id])
  classroom        Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  targetCompetency Competency?         @relation("RouteTargetCompetency", fields: [targetCompetencyId], references: [id], onDelete: SetNull)
  steps            LearningRouteStep[]

  @@index([institutionId])
  @@index([classroomId])
}

model LearningRouteStep {
  id            String   @id @default(cuid())
  institutionId String
  routeId       String
  activityId    String? // el paso ES una actividad (ClassroomActivity)
  competencyId  String? // competencia a la que contribuye este paso
  title         String
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution        @relation("RlsInstitutionLRS", fields: [institutionId], references: [id])
  route       LearningRoute      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  activity    ClassroomActivity? @relation("ActivityRouteSteps", fields: [activityId], references: [id], onDelete: SetNull)
  competency  Competency?        @relation("StepCompetency", fields: [competencyId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([routeId])
  @@index([activityId])
}

// ═══════════════════════════════════════════════════════════════════════════
// EDUSYN PLAY — Invitados, Lecciones Live, Reacciones y Conversión a nota
// ═══════════════════════════════════════════════════════════════════════════

// Invitado (sin cuenta) que entró a una LiveSession (quiz) o LiveLessonSession vía código
model LiveSessionGuest {
  id          String @id @default(cuid())
  sessionId   String // Polimórfico: LiveSession.id o LiveLessonSession.id (sin FK para permitir ambos)
  sessionKind String @default("QUIZ") // QUIZ | LESSON

  nickname    String
  avatarEmoji String? // 🦊 🐼 🐧 🦄 🐵 🐙 🦁 🐯
  guestToken  String  @unique

  // Antiabuso (hashes, nunca IP cruda)
  ipHash      String?
  userAgent   String? @db.Text
  fingerprint String?

  score          Int    @default(0)
  correctAnswers Int    @default(0)
  totalAnswers   Int    @default(0)
  finalRank      Int?
  percent        Float? // % final de aciertos

  joinedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  finishedAt DateTime?

  // Fase 2: reclamar resultado (vincular a cuenta real al loguearse)
  claimedByUserId String?
  claimedAt       DateTime?

  answers   LiveSessionGuestAnswer[]
  reactions LiveSessionReaction[]

  @@unique([sessionId, nickname])
  @@index([sessionId])
  @@index([guestToken])
}

model LiveSessionGuestAnswer {
  id      String           @id @default(cuid())
  guestId String
  guest   LiveSessionGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  questionId     String? // FK lógica a ActivityQuestion (sin constraint para soportar slides)
  slideId        String? // FK lógica a LessonSlide
  selectedOption String?
  answerText     String?  @db.Text
  isCorrect      Boolean  @default(false)
  pointsAwarded  Int      @default(0)
  timeTakenMs    Int?
  answeredAt     DateTime @default(now())

  @@index([guestId])
  @@index([questionId])
  @@index([slideId])
}

// Sesión de Lección Live (estilo Nearpod/Pear Deck) — presentación sincronizada
model LiveLessonSession {
  id          String @id @default(cuid())
  lessonId    String
  activityId  String
  classroomId String
  teacherId   String

  joinCode          String    @unique
  guestMode         GuestMode @default(GUESTS_ONLY)
  currentSlideIndex Int       @default(0)
  status            String    @default("LOBBY") // LOBBY | RUNNING | PAUSED | FINISHED
  publicUrl         String?
  guestsCount       Int       @default(0)

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([joinCode])
  @@index([activityId])
  @@index([classroomId])
  @@index([teacherId])
}

// Reacciones en vivo (💡 🤔 ❤ 👏) durante una Lección Live
model LiveSessionReaction {
  id         String            @id @default(cuid())
  sessionId  String // LiveSession.id o LiveLessonSession.id
  slideIndex Int?
  guestId    String?
  guest      LiveSessionGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  emoji      String // 💡 🤔 ❤ 👏
  createdAt  DateTime          @default(now())

  @@index([sessionId, slideIndex])
  @@index([guestId])
}

// Histórico de conversiones a nota (para que el docente pueda reimprimir la planilla)
model GuestGradeConversion {
  id              String   @id @default(cuid())
  sessionId       String // LiveSession.id o LiveLessonSession.id
  createdByUserId String
  maxScore        Float    @default(5)
  minScore        Float    @default(1)
  passingScore    Float    @default(3)
  method          String   @default("PROPORTIONAL")
  payload         Json // Snapshot de nicknames + notas calculadas
  createdAt       DateTime @default(now())

  @@index([sessionId])
  @@index([createdByUserId])
}

// ═══════════════════════════════════════════════════════════════════════════
// EXPEDICIÓN ABP — Aprendizaje Basado en Proyectos gamificado por equipos.
// Cada equipo avanza independiente por 6 fases con gating + validación docente.
// Multi-tenant: TODA tabla lleva institutionId (policy RLS por tabla).
// ═══════════════════════════════════════════════════════════════════════════
enum AbpProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AbpPhaseStatus {
  LOCKED
  IN_PROGRESS
  AWAITING
  VALIDATED
  RETURNED
}

enum AbpValidationStatus {
  PENDING
  APPROVED
  RETURNED
}

enum AbpContributionType {
  CANVAS_CARD
  IDEA
  VOTE
  TASK_DONE
  EVIDENCE
  COEVAL
}

enum AbpResourceType {
  PDF
  VIDEO
  LINK
  DOC
  OTHER
}

model AbpProject {
  id            String           @id @default(cuid())
  institutionId String
  classroomId   String
  title         String
  challenge     String?          @db.Text // reto general del proyecto
  presentation  Json? // portada Nivel 1: banner/video/mensaje/contexto/why/skills/rules/timeline
  status        AbpProjectStatus @default(ACTIVE)
  phaseConfig   Json? // mínimos por fase; defaults sensatos en código si null
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  institution   Institution       @relation("RlsInstitutionABPP", fields: [institutionId], references: [id])
  classroom     Classroom         @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  teams         AbpTeam[]
  resources     AbpResource[]
  announcements AbpAnnouncement[]

  @@index([institutionId])
  @@index([classroomId])
}

// Recursos generales del proyecto (Nivel 1): PDFs, videos, enlaces, tutoriales.
model AbpResource {
  id            String          @id @default(cuid())
  institutionId String
  projectId     String
  type          AbpResourceType @default(LINK)
  title         String
  url           String          @db.Text
  description   String?         @db.Text
  sortOrder     Int             @default(0)
  createdAt     DateTime        @default(now())

  institution Institution @relation("RlsInstitutionABPR", fields: [institutionId], references: [id])
  project     AbpProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([projectId])
}

// Anuncios del proyecto (Nivel 1): mensajes del docente que no se pierden en el foro.
model AbpAnnouncement {
  id            String   @id @default(cuid())
  institutionId String
  projectId     String
  content       String   @db.Text
  pinned        Boolean  @default(false)
  authorUserId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation("RlsInstitutionABPAN", fields: [institutionId], references: [id])
  project     AbpProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([projectId])
}

model AbpTeam {
  id            String   @id @default(cuid())
  institutionId String
  projectId     String
  name          String
  emoji         String   @default("🚀")
  color         String   @default("#0E4A5A")
  currentPhase  Int      @default(1) // 1–6
  xp            Int      @default(0) // XP de equipo (barra denormalizada)
  problem       String?  @db.Text // el reto propio del equipo
  badges        String[] @default([]) // insignias de equipo (códigos)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution   Institution            @relation("RlsInstitutionABPT", fields: [institutionId], references: [id])
  project       AbpProject             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members       AbpTeamMember[]
  phaseStates   AbpPhaseState[]
  validations   AbpValidationRequest[]
  contributions AbpContribution[]
  comments      AbpComment[]
  discoveries   AbpDiscovery[]
  logEntries    AbpLogEntry[]

  @@index([institutionId])
  @@index([projectId])
}

model AbpTeamMember {
  id                  String   @id @default(cuid())
  institutionId       String
  teamId              String
  studentEnrollmentId String
  createdAt           DateTime @default(now())

  institution       Institution       @relation("RlsInstitutionABPM", fields: [institutionId], references: [id])
  team              AbpTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentEnrollmentId])
  @@index([institutionId])
  @@index([studentEnrollmentId])
}

model AbpPhaseState {
  id            String         @id @default(cuid())
  institutionId String
  teamId        String
  phase         Int // 1–6
  status        AbpPhaseStatus @default(LOCKED)
  data          Json? // datos de la fase (canvas/ideas/smart/kanban/evidencias/coeval)
  feedback      String?        @db.Text // feedback del docente al devolver
  startedAt     DateTime? // al entrar a IN_PROGRESS
  submittedAt   DateTime? // al solicitar validación (AWAITING)
  validatedAt   DateTime? // al aprobar (VALIDATED)
  updatedAt     DateTime       @updatedAt

  institution Institution  @relation("RlsInstitutionABPS", fields: [institutionId], references: [id])
  team        AbpTeam      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  comments    AbpComment[]
  missions    AbpMission[]

  @@unique([teamId, phase])
  @@index([institutionId])
  @@index([teamId])
}

model AbpValidationRequest {
  id            String              @id @default(cuid())
  institutionId String
  teamId        String
  phase         Int
  status        AbpValidationStatus @default(PENDING)
  note          String?             @db.Text // nota del equipo al solicitar
  feedback      String?             @db.Text // feedback del docente al devolver
  rubricScores  Json? // { "0": 1-4, ... } por criterio de la fase (obligatoria al aprobar, en el servicio)
  rubricComment String?             @db.Text // comentario global de la valoración (opcional)
  createdAt     DateTime            @default(now())
  resolvedAt    DateTime?

  institution Institution @relation("RlsInstitutionABPV", fields: [institutionId], references: [id])
  team        AbpTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([teamId])
  @@index([status])
}

model AbpContribution {
  id                  String              @id @default(cuid())
  institutionId       String
  teamId              String
  studentEnrollmentId String
  phase               Int
  type                AbpContributionType
  refId               String? // id lógico del objeto (idea, tarea, tarjeta, evidencia)
  detail              String? // texto legible ("votó: sensor de fugas")
  createdAt           DateTime            @default(now())

  institution       Institution       @relation("RlsInstitutionABPC", fields: [institutionId], references: [id])
  team              AbpTeam           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([studentEnrollmentId, type, refId]) // idempotencia: 1 voto por idea, 1 tarjeta, etc.
  @@index([institutionId])
  @@index([teamId, phase])
  @@index([studentEnrollmentId])
  @@index([type])
}

// Comentarios en línea (docente ↔ equipo) sobre cualquier objeto de una fase.
enum AbpCommentRefType {
  CANVAS_CARD
  IDEA
  TASK
  EVIDENCE
  COEVAL
  PHASE
}

model AbpComment {
  id                        String            @id @default(cuid())
  institutionId             String
  teamId                    String
  phaseStateId              String
  refType                   AbpCommentRefType
  refId                     String? // id del objeto comentado; null si refType=PHASE
  authorStudentEnrollmentId String? // autor estudiante (cruza con AbpContribution)
  authorUserId              String? // autor docente
  authorName                String // denormalizado para pintar sin join
  authorRole                String // 'DOCENTE' | 'ESTUDIANTE'
  content                   String            @db.Text
  resolved                  Boolean           @default(false)
  parentId                  String? // respuesta a otro comentario (hilo)
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  institution      Institution        @relation("RlsInstitutionABPCM", fields: [institutionId], references: [id])
  team             AbpTeam            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  phaseState       AbpPhaseState      @relation(fields: [phaseStateId], references: [id], onDelete: Cascade)
  authorEnrollment StudentEnrollment? @relation(fields: [authorStudentEnrollmentId], references: [id], onDelete: SetNull)
  parent           AbpComment?        @relation("AbpCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          AbpComment[]       @relation("AbpCommentReplies")

  @@index([institutionId])
  @@index([teamId])
  @@index([phaseStateId, resolved, createdAt])
  @@index([refType, refId])
}

// ═══════════════════════════════════════════════════════════════════════════
// EXPEDICIÓN ABP V1 — Misiones (trabajo real dentro de las fases-hito),
// Actividades, Descubrimientos y Bitácora. Las fases son hitos; el trabajo vive
// en misiones (por equipo × fase). La herramienta de cada fase = misión por defecto.
// ═══════════════════════════════════════════════════════════════════════════
enum AbpMissionStatus {
  LOCKED
  IN_PROGRESS
  COMPLETED
}

enum AbpGeneratedBy {
  MANUAL
  TEMPLATE
  AI
}

enum AbpMissionActivityType {
  READING
  VIDEO
  QUIZ
  INTERVIEW
  UPLOAD
  LINK
  CUSTOM
}

enum AbpImpact {
  LOW
  MEDIUM
  HIGH
}

model AbpMission {
  id                String           @id @default(cuid())
  institutionId     String
  phaseStateId      String
  title             String
  description       String?          @db.Text
  sortOrder         Int              @default(0)
  status            AbpMissionStatus @default(IN_PROGRESS)
  required          Boolean          @default(true) // gating: obligatoria para validar la fase
  xp                Int              @default(0)
  generatedBy       AbpGeneratedBy   @default(MANUAL) // preparación Valeria V2
  generationContext Json? // contexto que usó la IA (problemática, DBA, competencias) — V2
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  institution Institution          @relation("RlsInstitutionABPMI", fields: [institutionId], references: [id])
  phaseState  AbpPhaseState        @relation(fields: [phaseStateId], references: [id], onDelete: Cascade)
  activities  AbpMissionActivity[]

  @@index([institutionId])
  @@index([phaseStateId, sortOrder])
}

model AbpMissionActivity {
  id                      String                 @id @default(cuid())
  institutionId           String
  missionId               String
  type                    AbpMissionActivityType
  title                   String
  content                 Json? // config por tipo (url, texto, quizId, instrucciones…)
  sortOrder               Int                    @default(0)
  completed               Boolean                @default(false)
  completedByEnrollmentId String? // quién la completó (participación)
  classroomActivityId     String? // si es una lección/juego jugable, apunta a la ClassroomActivity
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  institution       Institution        @relation("RlsInstitutionABPMA", fields: [institutionId], references: [id])
  mission           AbpMission         @relation(fields: [missionId], references: [id], onDelete: Cascade)
  completedBy       StudentEnrollment? @relation("AbpActivityCompletedBy", fields: [completedByEnrollmentId], references: [id], onDelete: SetNull)
  classroomActivity ClassroomActivity? @relation("AbpMissionActivityLesson", fields: [classroomActivityId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([missionId, sortOrder])
  @@index([classroomActivityId])
}

model AbpDiscovery {
  id                        String    @id @default(cuid())
  institutionId             String
  teamId                    String
  phase                     Int // fase donde ocurrió
  authorStudentEnrollmentId String?
  authorName                String
  title                     String
  description               String    @db.Text
  evidenceKind              String? // 'LINK' | 'FILE'
  evidenceUrl               String?
  impact                    AbpImpact @default(MEDIUM)
  createdAt                 DateTime  @default(now())

  institution      Institution        @relation("RlsInstitutionABPD", fields: [institutionId], references: [id])
  team             AbpTeam            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorEnrollment StudentEnrollment? @relation("AbpDiscoveryAuthor", fields: [authorStudentEnrollmentId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([teamId, phase])
}

model AbpLogEntry {
  id                        String   @id @default(cuid())
  institutionId             String
  teamId                    String
  phase                     Int?
  authorStudentEnrollmentId String?
  authorName                String
  content                   String   @db.Text
  createdAt                 DateTime @default(now())

  institution      Institution        @relation("RlsInstitutionABPL", fields: [institutionId], references: [id])
  team             AbpTeam            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  authorEnrollment StudentEnrollment? @relation("AbpLogAuthor", fields: [authorStudentEnrollmentId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([teamId])
}
