enum GuardianRelationship {
  FATHER
  MOTHER
  STEPFATHER
  STEPMOTHER
  GRANDFATHER
  GRANDMOTHER
  UNCLE
  AUNT
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

model StudentEnrollment {
  id             String @id @default(cuid())
  institutionId  String
  studentId      String
  academicYearId String
  groupId        String

  // Tipo y estado de matrícula
  enrollmentType EnrollmentType   @default(NEW)
  status         EnrollmentStatus @default(ACTIVE)

  // Jornada y modalidad
  shift    SchoolShift? // Jornada: Mañana, Tarde, Única, Noche
  modality StudyModality @default(PRESENTIAL)

  // Fechas
  enrollmentDate   DateTime  @default(now())
  withdrawalDate   DateTime? // Fecha de retiro si aplica
  withdrawalReason String? // Motivo del retiro

  // Trazabilidad de promoción
  promotedFromId  String?         @unique // Matrícula del año anterior (1:1)
  promotionStatus PromotionStatus @default(IN_PROGRESS)

  // Observaciones y auditoría
  observations String? // Observaciones de matrícula
  enrolledById String? // Quién realizó la matrícula

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  institution  Institution  @relation("RlsInstitutionSE", fields: [institutionId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  enrolledBy   User?        @relation("EnrollmentCreatedBy", fields: [enrolledById], references: [id])

  // Trazabilidad de promoción (self-relation 1:1)
  promotedFrom StudentEnrollment? @relation("EnrollmentPromotion", fields: [promotedFromId], references: [id])
  promotedTo   StudentEnrollment? @relation("EnrollmentPromotion")

  // Historial de eventos (AUDITORÍA)
  events EnrollmentEvent[]

  // Relaciones académicas
  grades                 StudentGrade[]
  periodFinalGrades      PeriodFinalGrade[]
  partialGrades          PartialGrade[]
  preventiveAlerts       PreventiveAlert[]
  attendanceRecords      AttendanceRecord[]
  studentObservations    StudentObservation[]
  periodRecoveries       PeriodRecovery[]
  finalRecoveryPlans     FinalRecoveryPlan[]
  academicActs           AcademicAct[]
  performanceManualEdits PerformanceManualEdit[]
  studentAchievements    StudentAchievement[]

  // Observador del estudiante (sub-módulos)
  observerCommitments ObserverCommitment[]
  guardianCitations   GuardianCitation[]
  observerReferrals   ObserverReferral[]
  pedagogicalMeasures PedagogicalMeasure[]

  // 🔥 SNAPSHOT de estructura académica al momento de matrícula
  enrollmentAreas      EnrollmentArea[]
  enrollmentSubjects   EnrollmentSubject[]
  enrollmentDimensions EnrollmentDimension[] // 🆕 Para estructura DIMENSIONS (preescolar)
  finalComponentGrades FinalComponentGrade[]

  // Snapshot legal de boletines por período
  reportCardSnapshots TermReportCardSnapshot[]

  // Acompañamiento pedagógico (DIMENSIONS)
  pedagogicalSupportPlans PedagogicalSupportPlan[]

  // Asistencia de tutoría
  tutoringAttendances TutoringAttendance[]

  // Aula Virtual
  classroomSubmissions ActivitySubmission[] @relation("ClassroomSubmissions")
  liveSessions         LiveSession[]
  activityAssignments  ActivityAssignment[]

  // Live Quiz
  liveSessionAnswers      LiveSessionAnswer[]
  liveTeamMembers         LiveSessionTeamMember[]
  liveSessionParticipants LiveSessionParticipant[]

  // Evaluación Actitudinal
  attitudinalAsEvaluator AttitudinalSubmission[] @relation("AttitudinalEvaluator")
  attitudinalAsTarget    AttitudinalSubmission[] @relation("AttitudinalTarget")
  peerAsEvaluator        PeerAssessmentPair[]    @relation("PeerEvaluator")
  peerAsTarget           PeerAssessmentPair[]    @relation("PeerTarget")

  // Lecciones interactivas
  lessonProgress LessonProgress[] @relation("LessonProgressEnrollment")

  // Expedición ABP
  abpTeamMemberships AbpTeamMember[]
  abpContributions   AbpContribution[]
  abpComments        AbpComment[]
  abpActivitiesDone  AbpMissionActivity[] @relation("AbpActivityCompletedBy")
  abpDiscoveries     AbpDiscovery[]       @relation("AbpDiscoveryAuthor")
  abpLogEntries      AbpLogEntry[]        @relation("AbpLogAuthor")

  @@unique([studentId, academicYearId])
}

// ═══════════════════════════════════════════════════════════════════════════
// SNAPSHOT DE ESTRUCTURA ACADÉMICA POR MATRÍCULA
// Copia inmutable de la configuración académica al momento de matricular
// Protege contra cambios posteriores en plantillas que dañarían históricos
// ═══════════════════════════════════════════════════════════════════════════

// Snapshot de área académica para una matrícula específica
// 🔥 100% AUTOSUFICIENTE: No depende del catálogo para existir
model EnrollmentArea {
  id            String  @id @default(cuid())
  institutionId String
  enrollmentId  String
  areaId        String? // Referencia OPCIONAL al catálogo (puede ser eliminada en el futuro)

  // Datos copiados de TemplateArea al momento de matrícula (INMUTABLES)
  areaName         String // Nombre del área (snapshot)
  areaCode         String? // Código del área (snapshot)
  weightPercentage Float // % del área en promedio general
  calculationType  AreaCalculationType // AVERAGE, WEIGHTED, DOMINANT, INFORMATIVE
  approvalRule     AreaApprovalRule // Regla de aprobación
  recoveryRule     AreaRecoveryRule // Regla de recuperación
  isMandatory      Boolean             @default(true)
  order            Int                 @default(0)

  createdAt DateTime @default(now())

  institution        Institution         @relation("RlsInstitutionEA", fields: [institutionId], references: [id])
  enrollment         StudentEnrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  area               Area?               @relation(fields: [areaId], references: [id], onDelete: SetNull)
  enrollmentSubjects EnrollmentSubject[]

  @@unique([enrollmentId, areaId])
  @@index([enrollmentId])
  @@index([areaId])
}

// Snapshot de asignatura académica para una matrícula específica
// 🔥 100% AUTOSUFICIENTE: No depende del catálogo para existir
model EnrollmentSubject {
  id               String  @id @default(cuid())
  institutionId    String
  enrollmentId     String
  enrollmentAreaId String
  subjectId        String? // Referencia OPCIONAL al catálogo (puede ser eliminada en el futuro)

  // Datos copiados de TemplateSubject al momento de matrícula (INMUTABLES)
  subjectName      String // Nombre de la asignatura (snapshot)
  subjectCode      String? // Código de la asignatura (snapshot)
  weeklyHours      Int     @default(0)
  weightPercentage Float // % dentro del área
  isDominant       Boolean @default(false)
  order            Int     @default(0)

  // Configuración de logros (snapshot)
  achievementsPerPeriod     Int     @default(1)
  useAttitudinalAchievement Boolean @default(false)

  // 🔥 Docente asignado al momento de matrícula (histórico)
  teacherId   String? // Referencia OPCIONAL al docente
  teacherName String? // Nombre completo del docente (snapshot)

  createdAt DateTime @default(now())

  institution    Institution       @relation("RlsInstitutionES", fields: [institutionId], references: [id])
  enrollment     StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentArea EnrollmentArea    @relation(fields: [enrollmentAreaId], references: [id], onDelete: Cascade)
  subject        Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher        User?             @relation("EnrollmentSubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, subjectId])
  @@index([enrollmentId])
  @@index([enrollmentAreaId])
  @@index([subjectId])
  @@index([teacherId])
}

// Snapshot de dimensión para una matrícula específica (PREESCOLAR)
model EnrollmentDimension {
  id            String  @id @default(cuid())
  institutionId String
  enrollmentId  String
  dimensionId   String? // Referencia histórica (opcional si se elimina)

  // Datos copiados de Dimension al momento de matrícula (INMUTABLES)
  dimensionName String // Nombre de la dimensión (snapshot visible)
  dimensionCode String? // Código de la dimensión (snapshot)
  order         Int     @default(0)

  createdAt DateTime @default(now())

  institution Institution       @relation("RlsInstitutionED", fields: [institutionId], references: [id])
  enrollment  StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  dimension   Dimension?        @relation(fields: [dimensionId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, dimensionId])
  @@index([enrollmentId])
}

// ═══════════════════════════════════════════════════════════════════════════
// HISTORIAL DE MATRÍCULA (AUDITORÍA LEGAL)
// ═══════════════════════════════════════════════════════════════════════════

model EnrollmentEvent {
  id            String                  @id @default(cuid())
  institutionId String
  enrollmentId  String
  type          EnrollmentEventType
  movementType  EnrollmentMovementType?

  // Auditoría de cambios
  previousValue Json? // Estado anterior (para auditoría)
  newValue      Json? // Estado nuevo
  reason        String? // Motivo del cambio
  observations  String? // Observaciones adicionales

  // Referencia a acta (si aplica)
  academicActId String? // Acta que respalda el cambio

  // Quién y cuándo
  performedById String
  performedAt   DateTime @default(now())

  institution Institution       @relation("RlsInstitutionEE", fields: [institutionId], references: [id])
  enrollment  StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  performedBy User              @relation("EnrollmentEventPerformedBy", fields: [performedById], references: [id])
  academicAct AcademicAct?      @relation(fields: [academicActId], references: [id])

  @@index([enrollmentId])
  @@index([performedAt])
  @@index([type])
}

model StudentGrade {
  id                   String   @id @default(cuid())
  institutionId        String
  studentEnrollmentId  String
  evaluativeActivityId String
  score                Decimal  @db.Decimal(5, 2)
  observations         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  institution        Institution        @relation("RlsInstitutionSG", fields: [institutionId], references: [id])
  studentEnrollment  StudentEnrollment  @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  evaluativeActivity EvaluativeActivity @relation(fields: [evaluativeActivityId], references: [id], onDelete: Restrict)

  @@unique([studentEnrollmentId, evaluativeActivityId])
}

model PeriodFinalGrade {
  id                  String   @id @default(cuid())
  institutionId       String
  studentEnrollmentId String
  academicTermId      String
  subjectId           String
  finalScore          Decimal  @db.Decimal(5, 2)
  observations        String?
  enteredById         String
  // C-1: nota final fijada manualmente. Si true, el recálculo desde parciales NO la sobreescribe.
  isManualOverride    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  institution       Institution       @relation("RlsInstitutionPFG", fields: [institutionId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicTerm      AcademicTerm      @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  enteredBy         User              @relation("PeriodGradeEnteredBy", fields: [enteredById], references: [id])

  @@unique([studentEnrollmentId, academicTermId, subjectId])
  @@index([studentEnrollmentId, academicTermId])
}

model PartialGrade {
  id                  String   @id @default(cuid())
  institutionId       String
  studentEnrollmentId String
  teacherAssignmentId String
  academicTermId      String
  componentType       String // COGNITIVO, PROCEDIMENTAL, ACTITUDINAL
  activityIndex       Int // Índice de la actividad (1, 2, 3, etc.)
  activityName        String // Nombre de la actividad
  activityType        String? // Tipo de actividad (Examen, Taller, etc.)
  score               Decimal  @db.Decimal(5, 2)
  observations        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  institution       Institution       @relation("RlsInstitutionPG", fields: [institutionId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  teacherAssignment TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Restrict)
  academicTerm      AcademicTerm      @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  @@unique([studentEnrollmentId, teacherAssignmentId, academicTermId, componentType, activityIndex])
  @@index([teacherAssignmentId, academicTermId])
  @@index([studentEnrollmentId, academicTermId])
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDITORÍA FORENSE DE NOTAS (append-only)
// Registra quién creó/cambió/borró una nota, cuándo y con qué valores.
// Hacia adelante: solo captura desde que se instrumenta (no recupera el pasado).
// ═══════════════════════════════════════════════════════════════════════════

enum GradeAuditAction {
  CREATE
  UPDATE
  DELETE
}

model GradeAuditEvent {
  id            String           @id @default(cuid())
  institutionId String
  source        String           @default("PARTIAL_GRADE") // origen del cambio (futuro: STUDENT_GRADE, etc.)
  action        GradeAuditAction

  // Quién y cuándo (snapshot del actor por si luego se desactiva o elimina)
  actorUserId String?
  actorName   String?
  actorRole   String?

  // Contexto del registro afectado
  partialGradeId      String? // id del registro (null tras DELETE)
  studentEnrollmentId String?
  teacherAssignmentId String?
  academicTermId      String?
  componentType       String?
  activityIndex       Int?
  activityName        String?

  // Valores (lo forense): nota anterior y nueva
  previousScore Decimal? @db.Decimal(5, 2)
  newScore      Decimal? @db.Decimal(5, 2)
  previousValue Json?
  newValue      Json?

  performedAt DateTime @default(now())

  institution Institution @relation("RlsInstitutionGAE", fields: [institutionId], references: [id])

  @@index([institutionId, performedAt])
  @@index([studentEnrollmentId])
  @@index([teacherAssignmentId, academicTermId])
  @@index([actorUserId])
}

// Auditoría forense de asistencia (append-only). Mismo enfoque que GradeAuditEvent.
model AttendanceAuditEvent {
  id            String           @id @default(cuid())
  institutionId String
  action        GradeAuditAction // CREATE / UPDATE / DELETE (enum compartido de acciones)

  actorUserId String?
  actorName   String?
  actorRole   String?

  attendanceRecordId  String? // id del registro (null tras DELETE)
  studentEnrollmentId String?
  teacherAssignmentId String?
  date                DateTime? @db.Date

  // Valores (lo forense): estado anterior y nuevo (PRESENT/ABSENT/LATE/EXCUSED)
  previousStatus String?
  newStatus      String?
  previousValue  Json?
  newValue       Json?

  performedAt DateTime @default(now())

  institution Institution @relation("RlsInstitutionAAE", fields: [institutionId], references: [id])

  @@index([institutionId, performedAt])
  @@index([studentEnrollmentId])
  @@index([teacherAssignmentId])
  @@index([actorUserId])
}

// ═══════════════════════════════════════════════════════════════════════════
// COMPONENTES FINALES (Pruebas Semestrales, Proyecto Final, etc.)
// Fuentes de nota ponderadas adicionales a los períodos para la nota anual
// ═══════════════════════════════════════════════════════════════════════════

model FinalComponent {
  id               String   @id @default(cuid())
  institutionId    String
  academicYearId   String
  name             String // "Prueba Semestral I", "Proyecto Final"
  weightPercentage Int // Peso en la nota anual (ej: 10)
  order            Int
  isOpen           Boolean  @default(false) // Controla si el ingreso de notas está habilitado
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institution  Institution           @relation("InstitutionFinalComponents", fields: [institutionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear          @relation("AcademicYearFinalComponents", fields: [academicYearId], references: [id], onDelete: Cascade)
  grades       FinalComponentGrade[]

  @@unique([academicYearId, order])
}

model FinalComponentGrade {
  id                  String   @id @default(cuid())
  institutionId       String
  studentEnrollmentId String
  teacherAssignmentId String
  finalComponentId    String
  grade               Decimal  @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  institution       Institution       @relation("RlsInstitutionFCG", fields: [institutionId], references: [id])
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  teacherAssignment TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  finalComponent    FinalComponent    @relation(fields: [finalComponentId], references: [id], onDelete: Cascade)

  @@unique([studentEnrollmentId, teacherAssignmentId, finalComponentId])
  @@index([teacherAssignmentId, finalComponentId])
}

enum PreventiveAlertStatus {
  OPEN
  IN_RECOVERY
  RESOLVED
}

model PreventiveCutConfig {
  id                 String   @id @default(cuid())
  academicTermId     String
  cutoffDate         DateTime
  riskThresholdScore Decimal  @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  academicTerm AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  @@unique([academicTermId])
}

model PreventiveAlert {
  id                  String                @id @default(cuid())
  institutionId       String
  teacherAssignmentId String
  studentEnrollmentId String
  academicTermId      String
  cutoffDate          DateTime
  computedGrade       Decimal?              @db.Decimal(5, 2)
  performanceLevel    PerformanceLevel?
  status              PreventiveAlertStatus @default(OPEN)
  recoveryPlan        String?
  meetingAt           DateTime?
  notes               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  institution       Institution       @relation("RlsInstitutionPA", fields: [institutionId], references: [id])
  teacherAssignment TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  academicTerm      AcademicTerm      @relation(fields: [academicTermId], references: [id], onDelete: Cascade)

  @@unique([teacherAssignmentId, studentEnrollmentId, academicTermId])
  @@index([teacherAssignmentId])
  @@index([studentEnrollmentId])
  @@index([academicTermId])
}

// ==================== ATTENDANCE ====================

enum AttendanceStatus {
  PRESENT // Presente
  ABSENT // Ausente
  LATE // Tardanza
  EXCUSED // Excusa justificada
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  institutionId       String
  teacherAssignmentId String
  studentEnrollmentId String
  date                DateTime         @db.Date
  status              AttendanceStatus
  observations        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  institution       Institution       @relation("RlsInstitutionAR", fields: [institutionId], references: [id])
  teacherAssignment TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([teacherAssignmentId, studentEnrollmentId, date])
  @@index([teacherAssignmentId])
  @@index([studentEnrollmentId])
  @@index([date])
  @@index([studentEnrollmentId, date])
}

// ==================== ASISTENCIA DE TUTORÍA ====================
// Modelo independiente para asistencia diaria / tutoría de grupo.
// No depende de TeacherAssignment ni de asignaturas.
// Se habilita por institución como feature "TUTORING_ATTENDANCE" del módulo ATTENDANCE.

model TutoringAttendance {
  id                  String           @id @default(cuid())
  institutionId       String
  groupId             String
  teacherId           String // Director de grupo / tutor
  studentEnrollmentId String
  date                DateTime         @db.Date
  status              AttendanceStatus
  observations        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

