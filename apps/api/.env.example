# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/edusyn?schema=public

# Server
PORT=3000
NODE_ENV=production

# JWT Secrets (generate secure random strings)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# Valeria IA (configura solo un proveedor; nunca subas claves reales al repositorio)
# APD_AI_PROVIDER=OPENROUTER
# OPENROUTER_API_KEY=
# APD_AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# APD_AI_MAX_TOKENS=2000
