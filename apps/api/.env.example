# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/edusyn?schema=public

# Server
PORT=3000
NODE_ENV=production

# JWT Secrets (generate secure random strings)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com
# Web Push for school event duels (generate with: npx web-push generate-vapid-keys --json)
# Store the private key only in the API secret manager; never commit real values.
MATH_EVENT_VAPID_PUBLIC_KEY=
MATH_EVENT_VAPID_PRIVATE_KEY=
MATH_EVENT_VAPID_SUBJECT=mailto:admin@example.edu.co
